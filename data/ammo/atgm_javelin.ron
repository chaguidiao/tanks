// Fictional fire-and-forget top-attack missile, mirroring the Javelin (original launch unit).
(
    id: "atgm_javelin",
    name: "ATGM JV",
    mirrors: "FGM-148 Javelin",
    kind: heat,
    guided: true,
    fire_and_forget: true,
    tandem: true,
    in_service: (from: 1996),
    muzzle_velocity_mps: (value: 140.0, source: "estimate (plan M8B-AT-TEAMS §6)", confidence: estimate,
        notes: "About 14 s to 2,000 m on the lofted top-attack path."),
    velocity_loss_mps_per_km: (value: 0.0, source: "estimate", confidence: estimate),
    flat_penetration_mm: (value: 760.0, source: "Wikipedia (FGM-148 Javelin): in excess of 760 mm RHA", confidence: low,
        notes: "Classified; the quoted figure is a lower bound."),
    dispersion_mrad: (value: 0.45, source: "estimate", confidence: estimate,
        notes: "Imaging seeker: tuned so that about nine shots in ten hit a tank in the open at 500-2,000 m (target A9: DoD, Ukraine 2022, 100 hits in the first 112 shots)."),
    top_attack_deg: (value: 45.0, source: "estimate", confidence: estimate,
        notes: "Climbs to about 150 m (Wikipedia) and dives onto the roof; the dive angle is not public."),
    min_range_m: (value: 150.0, source: "plan M8B-AT-TEAMS §6: 65 m direct attack, 150 m top attack", confidence: low,
        notes: "Top-attack mode only in v1."),
    max_range_m: (value: 2000.0, source: "Wikipedia (FGM-148 Javelin): 2,000 m with the early launch unit", confidence: low),
    preferred_vs: [mbt, ifv],
)
