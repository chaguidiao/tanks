// Fictional 120 mm APFSDS mirroring the original M829 (depleted uranium, 1985). Replaced by the
// M829A1 class (apfsds_120a) from 1988; a 1985-87 M1A1 carries this one.
(
    id: "apfsds_120_early",
    name: "APFSDS 120-E",
    mirrors: "M829",
    kind: apfsds,
    in_service: (from: 1985, to: 1989),
    muzzle_velocity_mps: (value: 1670.0, source: "Jane's Ammunition Handbook (open editions): M829 about 1,670 m/s", confidence: low),
    velocity_loss_mps_per_km: (value: 62.0, source: "McCoy, Modern Exterior Ballistics (1999), long-rod drag; estimate", confidence: estimate),
    rod_length_mm: (value: 556.0, source: "fitted so the model reproduces the reference penetration; open sources give no rod geometry", confidence: estimate),
    rod_diameter_mm: (value: 24.0, source: "estimate", confidence: estimate),
    rod_density_g_cm3: (value: 18.6, source: "depleted-uranium alloy density", confidence: medium),
    dispersion_mrad: (value: 0.22, source: "estimate", confidence: estimate),
    reference_penetration_2km_mm: (value: 540.0, source: "open-source estimates (range ~500-580 mm RHA at 2 km)", confidence: low),
    preferred_vs: [mbt],
)
