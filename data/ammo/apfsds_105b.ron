// Fictional 105 mm APFSDS mirroring the M833 class (depleted uranium, 1983).
(
    id: "apfsds_105b",
    name: "APFSDS 105-B",
    mirrors: "M833",
    kind: apfsds,
    in_service: (from: 1983),
    muzzle_velocity_mps: (value: 1480.0, source: "Jane's Ammunition Handbook (open editions): M833 about 1,480 m/s", confidence: low),
    velocity_loss_mps_per_km: (value: 70.0, source: "McCoy, Modern Exterior Ballistics (1999), long-rod drag; estimate", confidence: estimate),
    rod_length_mm: (value: 537.0, source: "fitted so the model reproduces the reference penetration; open sources give no rod geometry", confidence: estimate),
    rod_diameter_mm: (value: 26.0, source: "estimate", confidence: estimate),
    rod_density_g_cm3: (value: 18.6, source: "depleted-uranium alloy density", confidence: medium),
    dispersion_mrad: (value: 0.25, source: "estimate", confidence: estimate),
    reference_penetration_2km_mm: (value: 450.0, source: "open-source estimates (range ~420-500 mm RHA at 2 km)", confidence: low),
    preferred_vs: [mbt],
)
