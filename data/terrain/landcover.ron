// Land-cover classes (TERRAIN.md §2.4). Ids are raster values and must be 0..n in order.
// speed_factor multiplies cross-country speed (vegetation override, NRMM-style); 0 = no-go.
[
    (id: 0, name: "grassland", display_rgb: (54, 66, 52),
        speed_factor: (value: 1.0, source: "NATO AVT-248 NG-NRMM (2018), open terrain baseline", confidence: estimate, notes: "Reference class."),
        micro_relief_m: (value: 0.5, source: "estimate", confidence: estimate, notes: "Pasture: gentle swells."),
        canopy_height_m: (value: 0.0, source: "estimate", confidence: estimate, notes: "Open ground: no obstruction."),
        attenuation_per_m: (value: 0.0, source: "TERRAIN.md §5.3 Beer–Lambert; estimate", confidence: estimate),
        foot_speed_factor: (value: 1.0, source: "FM 3-21.18 Foot Marches (2017) ch. 1, terrain and march rates; estimate", confidence: estimate, notes: "Open ground: the cross-country march rate applies unchanged.")),
    (id: 1, name: "cropland", display_rgb: (66, 66, 50),
        speed_factor: (value: 0.95, source: "NATO AVT-248 NG-NRMM (2018)", confidence: estimate, notes: "Low crops barely slow a tank."),
        micro_relief_m: (value: 0.3, source: "estimate", confidence: estimate, notes: "Worked fields are smooth."),
        canopy_height_m: (value: 0.0, source: "estimate", confidence: estimate, notes: "Low crops do not mask vehicles."),
        attenuation_per_m: (value: 0.0, source: "TERRAIN.md §5.3 Beer–Lambert; estimate", confidence: estimate),
        foot_speed_factor: (value: 0.9, source: "FM 3-21.18 Foot Marches (2017) ch. 1, terrain and march rates; estimate", confidence: estimate, notes: "Rows and stubble slow walking slightly.")),
    (id: 2, name: "ploughed", display_rgb: (62, 56, 46),
        speed_factor: (value: 0.8, source: "NATO AVT-248 NG-NRMM (2018)", confidence: estimate, notes: "Furrows and loose soil."),
        micro_relief_m: (value: 0.4, source: "estimate", confidence: estimate),
        canopy_height_m: (value: 0.0, source: "estimate", confidence: estimate),
        attenuation_per_m: (value: 0.0, source: "TERRAIN.md §5.3 Beer–Lambert; estimate", confidence: estimate),
        foot_speed_factor: (value: 0.75, source: "FM 3-21.18 Foot Marches (2017) ch. 1, terrain and march rates; estimate", confidence: estimate, notes: "Furrows and loose soil tire a loaded soldier.")),
    (id: 3, name: "deciduous_forest", display_rgb: (40, 56, 42), is_forest: true,
        speed_factor: (value: 0.25, source: "NATO AVT-248 NG-NRMM (2018), vegetation override", confidence: estimate,
            notes: "Mature stems cannot be pushed over; vehicle must weave between trees."),
        micro_relief_m: (value: 1.0, source: "estimate", confidence: estimate, notes: "Forest floors are rough."),
        canopy_height_m: (value: 18.0, source: "estimate", confidence: estimate, notes: "Leaf-on stand: ~100 m of forest passes ~3 % (TERRAIN.md §5.3)."),
        attenuation_per_m: (value: 0.035, source: "TERRAIN.md §5.3 Beer–Lambert; estimate", confidence: estimate),
        foot_speed_factor: (value: 0.7, source: "FM 3-21.18 Foot Marches (2017) ch. 1, terrain and march rates; estimate", confidence: estimate, notes: "Passable on foot between stems; undergrowth and navigation slow the squad.")),
    (id: 4, name: "coniferous_forest", display_rgb: (36, 50, 42), is_forest: true,
        speed_factor: (value: 0.2, source: "NATO AVT-248 NG-NRMM (2018), vegetation override", confidence: estimate, notes: "Denser stems than deciduous stands."),
        micro_relief_m: (value: 1.0, source: "estimate", confidence: estimate),
        canopy_height_m: (value: 16.0, source: "estimate", confidence: estimate, notes: "Dense evergreen stand, no seasonal change."),
        attenuation_per_m: (value: 0.05, source: "TERRAIN.md §5.3 Beer–Lambert; estimate", confidence: estimate),
        foot_speed_factor: (value: 0.6, source: "FM 3-21.18 Foot Marches (2017) ch. 1, terrain and march rates; estimate", confidence: estimate, notes: "Denser stems and low branches than deciduous stands.")),
    (id: 5, name: "scrub", display_rgb: (58, 60, 46),
        speed_factor: (value: 0.7, source: "NATO AVT-248 NG-NRMM (2018)", confidence: estimate, notes: "Brush is overridden at reduced speed."),
        micro_relief_m: (value: 1.2, source: "estimate", confidence: estimate),
        canopy_height_m: (value: 2.0, source: "estimate", confidence: estimate, notes: "Brush partly masks hulls."),
        attenuation_per_m: (value: 0.02, source: "TERRAIN.md §5.3 Beer–Lambert; estimate", confidence: estimate),
        foot_speed_factor: (value: 0.7, source: "FM 3-21.18 Foot Marches (2017) ch. 1, terrain and march rates; estimate", confidence: estimate, notes: "Brush must be pushed through or walked around.")),
    (id: 6, name: "marsh", display_rgb: (46, 58, 60),
        speed_factor: (value: 0.15, source: "TERRAIN.md §5.2; NG-NRMM soft-soil limits", confidence: estimate, notes: "Very low soil strength; high bog-down risk."),
        micro_relief_m: (value: 0.3, source: "estimate", confidence: estimate),
        canopy_height_m: (value: 1.0, source: "estimate", confidence: estimate, notes: "Reeds."),
        attenuation_per_m: (value: 0.01, source: "TERRAIN.md §5.3 Beer–Lambert; estimate", confidence: estimate),
        foot_speed_factor: (value: 0.4, source: "FM 3-21.18 Foot Marches (2017) ch. 1, terrain and march rates; estimate", confidence: estimate, notes: "Soft ground and standing water; passable on foot where vehicles bog.")),
    (id: 7, name: "water", display_rgb: (34, 48, 62), is_water: true,
        speed_factor: (value: 0.3, source: "estimate", confidence: estimate, notes: "Fordable shallows only; depth checked separately against fording depth."),
        micro_relief_m: (value: 0.0, source: "estimate", confidence: estimate),
        canopy_height_m: (value: 0.0, source: "estimate", confidence: estimate),
        attenuation_per_m: (value: 0.0, source: "TERRAIN.md §5.3 Beer–Lambert; estimate", confidence: estimate),
        foot_speed_factor: (value: 0.4, source: "FM 3-21.18 Foot Marches (2017) ch. 1, terrain and march rates; estimate", confidence: estimate, notes: "Wading; depth checked separately against the fording depth.")),
    (id: 8, name: "village", display_rgb: (70, 66, 62), built_up: true,
        speed_factor: (value: 0.4, source: "TERRAIN.md §5.4", confidence: estimate, notes: "Streets and gardens between buildings; buildings themselves are not modelled yet."),
        micro_relief_m: (value: 0.2, source: "estimate", confidence: estimate),
        canopy_height_m: (value: 4.0, source: "estimate", confidence: estimate, notes: "Gardens, hedges and trees between buildings; buildings themselves are footprints."),
        attenuation_per_m: (value: 0.02, source: "TERRAIN.md §5.3 Beer–Lambert; estimate", confidence: estimate),
        foot_speed_factor: (value: 0.9, source: "FM 3-21.18 Foot Marches (2017) ch. 1, terrain and march rates; estimate", confidence: estimate, notes: "Gardens, fences and walls between buildings.")),
    (id: 9, name: "road", display_rgb: (92, 88, 78),
        speed_factor: (value: 1.0, source: "estimate", confidence: estimate, notes: "Speed then limited by governed road speed."),
        micro_relief_m: (value: 0.0, source: "estimate", confidence: estimate),
        canopy_height_m: (value: 0.0, source: "estimate", confidence: estimate),
        attenuation_per_m: (value: 0.0, source: "TERRAIN.md §5.3 Beer–Lambert; estimate", confidence: estimate),
        foot_speed_factor: (value: 1.0, source: "FM 3-21.18 Foot Marches (2017) ch. 1, terrain and march rates; estimate", confidence: estimate, notes: "Speed then limited by the road march rate.")),
    (id: 10, name: "track", display_rgb: (80, 74, 62),
        speed_factor: (value: 1.0, source: "estimate", confidence: estimate),
        micro_relief_m: (value: 0.1, source: "estimate", confidence: estimate),
        canopy_height_m: (value: 0.0, source: "estimate", confidence: estimate),
        attenuation_per_m: (value: 0.0, source: "TERRAIN.md §5.3 Beer–Lambert; estimate", confidence: estimate),
        foot_speed_factor: (value: 1.0, source: "FM 3-21.18 Foot Marches (2017) ch. 1, terrain and march rates; estimate", confidence: estimate, notes: "Speed then limited by the track march rate.")),
