// Fire support (DESIGN.md decision 21). Battery performance follows open descriptions of
// self-propelled howitzers (FM 6-40 / ATP 3-09.42 for the call-for-fire sequence and ranging
// errors); effects on armour are estimates: a 150 mm HE shell rarely kills a tank except on a
// direct hit, but reliably damages sights, tracks and thin-skinned vehicles.
(
    batteries: [
        (id: "sph155_btry", name: "155 MM SP BATTERY", mirrors: "M109A6 Paladin battery (4 of 6 guns)",
            in_service: (from: 1963),
            tubes: 4,
            min_range_m: (value: 2000, source: "M109A6 minimum range with the lowest charge, open sources", confidence: low),
            max_range_m: (value: 22000, source: "M109A6 maximum range, HE, open sources (about 22-24 km)", confidence: medium),
            fdc_delay_s: (value: 75, source: "estimate: ATP 3-09.42 describes a quick call for fire; delays of 1-3 minutes are typical for a trained FDC", confidence: estimate),
            volley_interval_s: (value: 15, source: "estimate: rapid fire of about 4 rounds per minute per gun", confidence: estimate),
            tof_base_s: (value: 8, source: "estimate", confidence: estimate),
            tof_per_km_s: (value: 3.6, source: "estimate: about 40-65 s of flight at 10-15 km for 155 mm HE", confidence: estimate),
            range_error_frac: (value: 0.004, source: "FM 6-40 / firing tables: range probable error about 0.3 per cent of range at medium charges, sigma 1.48 x PE", confidence: low),
            deflection_error_mrad: (value: 1.2, source: "estimate: firing-table deflection probable error about 0.8 mil", confidence: estimate),
            range_bias_frac: (value: 0.004, source: "estimate: systematic error of unregistered fire (no met or registration) is comparable to the random error, FM 6-40 / ATP 3-09.42 on adjusting fire", confidence: estimate),
            deflection_bias_mrad: (value: 1.5, source: "estimate", confidence: estimate),
            adjust_delay_s: (value: 20, source: "estimate: the FDC applies a correction faster than it processes a new mission", confidence: estimate),
            he_rounds: 72, smoke_rounds: 16, smoke_kind: "arty_wp"),
        (id: "sph152_btry", name: "152 MM SP BATTERY", mirrors: "2S3 Akatsiya battery (6 guns)",
            in_service: (from: 1971),
            tubes: 6,
            min_range_m: (value: 1500, source: "2S3 minimum range, open sources", confidence: low),
            max_range_m: (value: 18500, source: "2S3 maximum range, HE, open sources", confidence: medium),
            fdc_delay_s: (value: 90, source: "estimate", confidence: estimate, notes: "Less automated fire control than a Western battery."),
            volley_interval_s: (value: 15, source: "estimate", confidence: estimate),
            tof_base_s: (value: 8, source: "estimate", confidence: estimate),
            tof_per_km_s: (value: 3.9, source: "estimate", confidence: estimate),
            range_error_frac: (value: 0.005, source: "estimate", confidence: estimate),
            deflection_error_mrad: (value: 1.5, source: "estimate", confidence: estimate),
            range_bias_frac: (value: 0.006, source: "estimate: systematic error of unregistered fire (no met or registration) is comparable to the random error, FM 6-40 / ATP 3-09.42 on adjusting fire", confidence: estimate),
            deflection_bias_mrad: (value: 2.0, source: "estimate", confidence: estimate),
            adjust_delay_s: (value: 25, source: "estimate: the FDC applies a correction faster than it processes a new mission", confidence: estimate),
            he_rounds: 96, smoke_rounds: 12, smoke_kind: "arty_wp"),
    ],
    effects: (
        direct_radius_m: (value: 6.0, source: "estimate: a 150 mm shell has to land within a few metres to hit a vehicle's roof or tracks", confidence: estimate),
        personnel_lethal_radius_m: (value: 35.0, source: "estimate: open descriptions give a lethal radius against standing men of a few tens of metres for 150 mm HE", confidence: estimate),
        near_radius_m: (value: 35.0, source: "estimate: lethal fragment radius against light vehicles tens of metres", confidence: estimate),
        classes: [
        (class: mbt,
            direct: (catastrophic: (value: 0.08, source: "estimate", confidence: estimate), firepower: (value: 0.12, source: "estimate", confidence: estimate), mobility: (value: 0.25, source: "estimate", confidence: estimate), crew: (value: 0.2, source: "estimate", confidence: estimate)),
            near: (catastrophic: (value: 0.0, source: "estimate", confidence: estimate), firepower: (value: 0.01, source: "estimate", confidence: estimate), mobility: (value: 0.03, source: "estimate", confidence: estimate), crew: (value: 0.02, source: "estimate", confidence: estimate)),
            near_sights: (value: 0.15, source: "estimate", confidence: estimate)),
        (class: ifv,
            direct: (catastrophic: (value: 0.35, source: "estimate", confidence: estimate), firepower: (value: 0.2, source: "estimate", confidence: estimate), mobility: (value: 0.2, source: "estimate", confidence: estimate), crew: (value: 0.1, source: "estimate", confidence: estimate)),
            near: (catastrophic: (value: 0.0, source: "estimate", confidence: estimate), firepower: (value: 0.05, source: "estimate", confidence: estimate), mobility: (value: 0.08, source: "estimate", confidence: estimate), crew: (value: 0.05, source: "estimate", confidence: estimate)),
            near_sights: (value: 0.3, source: "estimate", confidence: estimate)),
        (class: recon,
            direct: (catastrophic: (value: 0.6, source: "estimate", confidence: estimate), firepower: (value: 0.15, source: "estimate", confidence: estimate), mobility: (value: 0.15, source: "estimate", confidence: estimate), crew: (value: 0.05, source: "estimate", confidence: estimate)),
            near: (catastrophic: (value: 0.02, source: "estimate", confidence: estimate), firepower: (value: 0.08, source: "estimate", confidence: estimate), mobility: (value: 0.12, source: "estimate", confidence: estimate), crew: (value: 0.08, source: "estimate", confidence: estimate)),
            near_sights: (value: 0.4, source: "estimate", confidence: estimate)),
        ],
    ),
    suppression: (
        burst_radius_m: (value: 60, source: "estimate: crews close hatches for bursts within a few tens of metres", confidence: estimate),
        burst_peak: (value: 0.35, source: "estimate", confidence: estimate),
        decay_per_s: (value: 0.03, source: "estimate: suppression fades in about half a minute", confidence: estimate),
        near_miss: (value: 0.12, source: "estimate", confidence: estimate),
        glancing_hit: (value: 0.3, source: "estimate", confidence: estimate),
        sensor_penalty: (value: 0.5, source: "estimate: a buttoned-up crew sees through periscopes only", confidence: estimate),
        slow_gain: (value: 0.8, source: "estimate", confidence: estimate),
        react_radius_m: (value: 150, source: "estimate", confidence: estimate),
        react_window_s: (value: 8, source: "estimate", confidence: estimate),
        react_cooldown_s: (value: 60, source: "estimate", confidence: estimate),
    ),
)
