// Obstacles, mines and breaching kits (docs/plans/M8D-ENGINEERS.md §2–§3). Main sources, all
// public: FM 20-32 (1998, C1-C3 2002) Mine/Countermine Operations (densities, encounter, lane
// width, plough and roller); FM 90-7 (1994) Combined Arms Obstacle Integration and ATP 3-90.8
// (2021) for obstacle effects; a USMC TBS lesson "Engineering in the Offense and Defense"
// (B3L4038) for anti-tank ditch criteria. Where the manuals give no figure, the value is an
// estimate with the reasoning in the notes.
(
    kinds: [
        (id: "ditch", name: "ANTI-TANK DITCH", vehicle: gap,
            foot_factor: (value: 0.3, source: "estimate", confidence: estimate, notes: "Men climb down and up the sides."),
            width_m: (value: 4.0, source: "USMC TBS B3L4038, Engineering in the Offense and Defense: an AT ditch is wider than 2.8 m (beyond a tank's self-bridging); estimate", confidence: low),
            height_m: (value: 2.0, source: "USMC TBS B3L4038: deeper than 1.5 m (beyond a tank's step); estimate", confidence: low),
            detect_range_m: (value: 1500.0, source: "estimate", confidence: estimate, notes: "A spoil bank and a long straight cut stand out at ground level well inside tank engagement range."),
            hand_breach_s: None, kit_breach: false),
        (id: "wire", name: "WIRE", vehicle: slow(0.3),
            foot_factor: (value: 0.0, source: "FM 90-7 (1994): wire obstacles stop dismounted movement until breached", confidence: medium),
            width_m: (value: 3.0, source: "estimate: triple standard concertina, three coils of about 1 m", confidence: estimate),
            height_m: (value: 1.0, source: "estimate: one coil high, a second on top", confidence: estimate),
            detect_range_m: (value: 800.0, source: "estimate", confidence: estimate, notes: "Pickets and coils are thin; seen at medium range with optics."),
            hand_breach_s: (value: 120.0, source: "FM 20-32 (1998) ch. 10: a Bangalore torpedo kit clears a 1 x 15 m lane through wire; estimate", confidence: estimate, notes: "Placing and firing the charge, about 2 min."),
            kit_breach: true),
        (id: "abatis", name: "ABATIS", vehicle: no_go,
            foot_factor: (value: 0.3, source: "estimate", confidence: estimate, notes: "Felled trees: men climb through."),
            width_m: (value: 10.0, source: "estimate: trees felled across a road or ride, overlapping", confidence: estimate),
            height_m: (value: 1.5, source: "estimate", confidence: estimate),
            detect_range_m: (value: 1000.0, source: "estimate", confidence: estimate),
            hand_breach_s: (value: 900.0, source: "estimate", confidence: estimate, notes: "Cutting charges on the trunks and dragging them clear, about 15 min."),
            kit_breach: false),
        (id: "teeth", name: "DRAGON'S TEETH", vehicle: no_go,
            foot_factor: (value: 0.5, source: "estimate", confidence: estimate),
            width_m: (value: 3.0, source: "estimate: two or three staggered rows of concrete blocks", confidence: estimate),
            height_m: (value: 1.2, source: "estimate", confidence: estimate),
            detect_range_m: (value: 2000.0, source: "estimate", confidence: estimate),
            hand_breach_s: None, kit_breach: false),
        (id: "minefield", name: "MINEFIELD", vehicle: mined,
            foot_factor: (value: 1.0, source: "plan M8D §0: anti-personnel mines are out of scope; anti-tank mines need far more pressure than a man", confidence: medium),
            width_m: (value: 100.0, source: "FM 20-32 (1998) ch. 2, minefield variables: the standard depth should start with 100 m", confidence: medium),
            height_m: (value: 0.0, source: "buried", confidence: high),
            detect_range_m: (value: 50.0, source: "estimate", confidence: estimate, notes: "Buried mines: disturbed soil and marker fences only close up; a strike reveals the field at once."),
            hand_breach_s: None, kit_breach: true),
    ],
    mines: [
        (id: "at_pressure", name: "AT MINE, PRESSURE (TM-62 / M15 CLASS)", fuze: pressure, in_service: (from: 1953),
            effective_width_m: (value: 1.0, source: "calibrated to FM 20-32 (1998) ch. 2-3 and 6: with 2.0 m for full-width mines, the four standard row minefields of figures 6-10 to 6-12 give 49/57/81/84 % encounter against the manual's 50/50-60/80/85+ % (test standard_minefields_give_the_manuals_encounter_rates)", confidence: low,
                notes: "Two tracks of about 0.6 m, less the mine's own width margin; pressure mines fire only under a track or wheel (FM 20-32 ch. 2)."),
            destroy_share: (value: 0.1, source: "estimate", confidence: estimate, notes: "FM 20-32 ch. 2: track-width mines have a lower probability of kill than full-width mines; a blast under a track cuts it."),
            immobilise_share: (value: 0.8, source: "estimate", confidence: estimate)),
        (id: "at_full_width", name: "AT MINE, FULL WIDTH (TM-72 / M21 CLASS)", fuze: full_width, in_service: (from: 1965),
            effective_width_m: (value: 2.0, source: "calibrated to FM 20-32 (1998), as for at_pressure", confidence: low,
                notes: "Tilt rod or magnetic: fires anywhere under the hull, so about the hull width, less where the charge misses the belly."),
            destroy_share: (value: 0.5, source: "estimate", confidence: estimate, notes: "FM 20-32 ch. 3: full-width mines are made to give a catastrophic kill through the belly, but not when the track runs straight over the mine."),
            immobilise_share: (value: 0.4, source: "estimate", confidence: estimate)),
    ],
    kits: [
        (id: "plough_b", name: "MINE PLOUGH", kind: plough, in_service: (from: 1985),
            fits: ["bulwark_a0", "bulwark_a1", "bulwark_a2"],
            breach_speed_mps: (value: 2.5, source: "FM 20-32 (1998) ch. 10: an M1 with the mine-clearing blade ploughs at 8 to 10 km/h, depending on the soil", confidence: medium),
            clear_pressure: (value: 0.9, source: "estimate", confidence: estimate, notes: "FM 20-32 ch. 10: the blade lifts most single-impulse pressure mines aside; no percentage given."),
            clear_full_width: (value: 0.8, source: "estimate", confidence: estimate, notes: "FM 20-32 ch. 10: the dog-bone assembly defeats tilt-rod mines and the improved one magnetic mines; none of it is certain.")),
        (id: "roller_b", name: "MINE ROLLER", kind: roller, in_service: (from: 1985),
            fits: ["bulwark_a0", "bulwark_a1", "bulwark_a2"],
            breach_speed_mps: (value: 2.8, source: "FM 20-32 (1998) ch. 10: a roller tank moves at 5 to 15 km/h, in a straight line", confidence: medium),
            clear_pressure: (value: 0.95, source: "estimate", confidence: estimate, notes: "FM 20-32 ch. 10: designed to defeat most single-pulse pressure mines by setting them off."),
            clear_full_width: (value: 0.7, source: "estimate", confidence: estimate, notes: "Only the dog-bone and chain between the roller banks catch tilt rods."),
            strikes: (value: 2.0, source: "FM 20-32 (1998) ch. 10: designed to resist two conventional-mine strikes", confidence: medium)),
        (id: "plough_r", name: "MINE PLOUGH (KMT-6 CLASS)", kind: plough, in_service: (from: 1970),
            fits: ["kurgan_a", "kurgan_b", "kurgan_c", "kholm_b", "uval_b"],
            breach_speed_mps: (value: 2.5, source: "estimate: the same work as the Western blade", confidence: estimate),
            clear_pressure: (value: 0.9, source: "estimate", confidence: estimate),
            clear_full_width: (value: 0.6, source: "estimate", confidence: estimate, notes: "Track-width plough with no chain between the blades.")),
        (id: "roller_r", name: "MINE ROLLER (KMT-7 CLASS)", kind: roller, in_service: (from: 1975),
            fits: ["kurgan_a", "kurgan_b", "kurgan_c", "kholm_b", "uval_b"],
            breach_speed_mps: (value: 2.8, source: "estimate: as the Western roller", confidence: estimate),
            clear_pressure: (value: 0.95, source: "estimate", confidence: estimate),
            clear_full_width: (value: 0.7, source: "estimate", confidence: estimate),
            strikes: (value: 2.0, source: "estimate: as the Western roller (FM 20-32 ch. 10)", confidence: estimate)),
    ],
    lane_width_m: (value: 4.5, source: "FM 20-32 (1998) ch. 10, initial lane marking: a mounted lane is 4.5 m wide", confidence: high),
    lane_overrun_m: (value: 100.0, source: "FM 20-32 (1998) ch. 10: the plough starts about 100 m short of the estimated leading edge and goes on 100 m past the far edge", confidence: high),
    lane_follow_factor: (value: 0.1, source: "estimate", confidence: estimate,
        notes: "FM 20-32 ch. 10 and FM 3-34.2: vehicles follow in the breacher's cleared track paths and the lane is proofed; few of the mines the kit missed lie where the following tracks run."),
    hand_breach_mine_m_per_min: (value: 4.0, source: "estimate", confidence: estimate,
        notes: "FM 20-32 gives no rate, only that the engineers are exposed in the lane for 5 minutes or more. Probing, lifting and marking a 4.5 m lane: about 25 min through a 100 m field."),
    bypass_detour_factor: (value: 2.5, source: "estimate", confidence: estimate,
        notes: "ATP 3-90.4: bypass when time and terrain allow. A detour up to two and a half times the remaining route is still quicker than a deliberate breach."),
    breach_detour_factor: (value: 1.2, source: "estimate", confidence: estimate,
        notes: "ATP 3-90.4: a lane already open is used rather than breaching again; a short detour to it is worth it."),
    breach_suppression_stop: (value: 0.5, source: "estimate", confidence: estimate,
        notes: "FM 3-34.2 (2000) SOSRA: reduction needs the enemy suppressed; a breach team under heavy fire stops work."),
)
