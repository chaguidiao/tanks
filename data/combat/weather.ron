// Weather presets (DESIGN.md decision 20). Visibility is the meteorological range (Koschmieder,
// extinction 3.912 / V); thermal extinction is for 8-12 um. Fog droplets are comparable to the
// thermal wavelength, so fog hurts thermal imagers almost as much as optics; dust and haze
// particles are much smaller, so thermal imagers see through them.
(
    presets: [
        (
            id: "clear",
            name: "CLEAR",
            visibility_m: (value: 40000.0, source: "WMO visibility code: excellent, over 40 km", confidence: medium, notes: "Chosen so that the earlier clear-air detection tuning is unchanged."),
            thermal_extinction_per_m: (value: 0.00005, source: "estimate: dry air, 8-12 um window", confidence: estimate),
            sky_light: (value: 1.0, source: "reference", confidence: high),
            dust_cue: (value: 1.5, source: "estimate: dry ground raises a plume behind a fast vehicle", confidence: estimate),
            precipitation_mm_h: 0.0,
        ),
        (
            id: "haze",
            name: "HAZE",
            visibility_m: (value: 5000.0, source: "WMO visibility code: moderate, 4-10 km", confidence: medium),
            thermal_extinction_per_m: (value: 0.0001, source: "estimate: haze particles are small against 8-12 um", confidence: estimate),
            sky_light: (value: 0.9, source: "estimate", confidence: estimate),
            dust_cue: (value: 1.5, source: "estimate", confidence: estimate),
            precipitation_mm_h: 0.0,
        ),
        (
            id: "overcast",
            name: "OVERCAST",
            visibility_m: (value: 15000.0, source: "WMO visibility code: good", confidence: medium),
            thermal_extinction_per_m: (value: 0.00008, source: "estimate", confidence: estimate),
            sky_light: (value: 0.5, source: "estimate: cloud cover removes the moon and most of the twilight glow", confidence: estimate),
            dust_cue: (value: 1.2, source: "estimate", confidence: estimate),
            precipitation_mm_h: 0.0,
        ),
        (
            id: "rain",
            name: "RAIN",
            visibility_m: (value: 3000.0, source: "estimate: moderate rain, about 5 mm/h, 2-4 km", confidence: low),
            thermal_extinction_per_m: (value: 0.0005, source: "estimate: rain attenuates 8-12 um modestly", confidence: estimate),
            sky_light: (value: 0.6, source: "estimate", confidence: estimate),
            dust_cue: (value: 1.0, source: "estimate: wet ground raises no dust", confidence: estimate),
            precipitation_mm_h: 5.0,
        ),
        (
            id: "fog",
            name: "FOG",
            visibility_m: (value: 250.0, source: "WMO visibility code: dense fog, under 1 km (here 250 m)", confidence: medium),
            thermal_extinction_per_m: (value: 0.009, source: "estimate: fog droplets are comparable to 8-12 um; thermal range is only mildly better than visual", confidence: estimate),
            sky_light: (value: 0.7, source: "estimate", confidence: estimate),
            dust_cue: (value: 1.0, source: "estimate", confidence: estimate),
            precipitation_mm_h: 0.0,
        ),
        (
            id: "dust",
            name: "DUST STORM",
            visibility_m: (value: 700.0, source: "estimate: blowing dust, 500-1000 m", confidence: low),
            thermal_extinction_per_m: (value: 0.0008, source: "estimate: dust particles are small against 8-12 um, so thermal imagers see through", confidence: estimate),
            sky_light: (value: 0.6, source: "estimate", confidence: estimate),
            dust_cue: (value: 1.0, source: "estimate: the air is already full of dust", confidence: estimate),
            precipitation_mm_h: 0.0,
        ),
    ],
)
