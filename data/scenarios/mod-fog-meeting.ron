// M7e Modern scenario (2005): fog at dawn. Fog blinds optics and thermal imagers alike, so the
// A2's sensor advantage disappears and the fight happens at a few hundred metres, where the T-90's
// reactive armour and gun-launched missiles matter. Play as Blue; the Blue AI plan is used only
// when the side is not player-controlled (headless runs, tests).
(
    id: "mod-fog-meeting",
    name: "FOG AT DAWN",
    date: (2005, 10, 3),
    start_time_s: 23400, // 06:30
    map: (id: "demo", recipe: "rolling-farmland", seed: 42, size_m: 8000.0),
    seed: 9,
    weather: (preset: "fog", latitude_deg: 50.0, wind_speed_mps: 1.0, wind_from_deg: 270.0),
    briefing: "SITUATION: A RED FORCE OF T-90A AND T-72B TANKS AND INFANTRY FIGHTING VEHICLES IS EXPECTED FROM THE NORTH-EAST. DENSE FOG LIMITS VISIBILITY TO A FEW HUNDRED METRES.\n\nMISSION: 1ST PLATOON (M1A2) AND 2ND PLATOON (M2A2 WITH TOW-2) HOLD THE VILLAGE CROSSROADS FOR 45 MINUTES. A SIDE THAT LOSES 70 % OF ITS VEHICLES LOSES.\n\nNOTES: THERMAL IMAGERS DO NOT SEE THROUGH FOG; CONTACT WILL COME AT SHORT RANGE. SET OVERLAPPING FIELDS OF FIRE AND EXPECT FLANK SHOTS. THE T-90A FRONT IS HARD TO PENETRATE: AIM FOR THE SIDES.",
    objectives: [(name: "VILLAGE", centre: (4500.0, 4300.0), radius_m: 350.0)],
    victory: (time_limit_s: 2700.0, objective: "VILLAGE", attacker: 1, destroyed_fraction: 0.7),
