// M8b-b tech demo (docs/plans/M8B-AT-TEAMS.md §10.8, decision 9): a Blue tank platoon must take
// a village held by Red infantry with RPGs in the houses and a missile team covering the eastern
// approach. Play as Blue: the RPGs hold fire until a tank shows its flank inside 200 m; the
// missile team gives itself away when it fires. Use HE on the houses, smoke, and stand-off;
// do not drive down the street blind. Red has no commander AI: its squads hold their houses.
(
    id: "m8b-ambush",
    name: "AMBUSH IN THE VILLAGE",
    date: (1987, 6, 15),
    start_time_s: 36000, // 10:00
    map: (id: "demo", recipe: "rolling-farmland", seed: 42, size_m: 8000.0),
    seed: 11,
    briefing: "SITUATION: RED INFANTRY WITH ANTI-TANK WEAPONS HOLDS THE VILLAGE 2 KM WEST. A MISSILE TEAM IS REPORTED ON THE EAST EDGE.\n\nMISSION: 1ST TANK PLATOON CLEARS THE VILLAGE WITHIN 30 MINUTES.\n\nNOTES: RPG TEAMS IN HOUSES WAIT FOR A FLANK SHOT INSIDE 200 M. A MISSILE LAUNCH GIVES THE TEAM AWAY: ENGAGE IT AT ONCE. MASONRY HOUSES NEED HE.",
    objectives: [(name: "VILLAGE", centre: (4560.0, 4310.0), radius_m: 300.0)],
    victory: (time_limit_s: 1800.0, objective: "VILLAGE", attacker: 0, destroyed_fraction: 0.75),
    sides: [
        (
            name: "BLUE",
            doctrine: "western-combined",
            units: [
                (callsign: "1-1", vehicle: "bulwark_a1", position: (6400.0, 4300.0), heading_deg: 270.0, platoon: "1"),
                (callsign: "1-2", vehicle: "bulwark_a1", position: (6440.0, 4360.0), heading_deg: 270.0, platoon: "1"),
                (callsign: "1-3", vehicle: "bulwark_a1", position: (6440.0, 4240.0), heading_deg: 270.0, platoon: "1"),
                (callsign: "1-4", vehicle: "bulwark_a1", position: (6480.0, 4300.0), heading_deg: 270.0, platoon: "1"),
            ],
        ),
        (
            name: "RED",
            doctrine: "generic-opfor",
            units: [
                // Squads placed inside houses occupy them at the start.
                (callsign: "2-1A", squad: "mr_squad", position: (4638.5, 4305.0), heading_deg: 90.0, platoon: "2-D"),
                (callsign: "2-1B", squad: "mr_squad", position: (4675.2, 4272.5), heading_deg: 90.0, platoon: "2-D"),
                (callsign: "2-1C", squad: "mr_squad", position: (4517.3, 4350.8), heading_deg: 90.0, platoon: "2-D"),
                (callsign: "AT-1", squad: "at_team_r", position: (4775.2, 4268.5), heading_deg: 90.0, platoon: "2-AT"),
            ],
        ),
    ],
