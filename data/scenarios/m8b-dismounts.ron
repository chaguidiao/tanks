                (callsign: "1-1A", squad: "rifle_squad_b", mounted_in: "1-1", position: (0.0, 0.0), heading_deg: 0.0),
                (callsign: "1-2A", squad: "rifle_squad_b", mounted_in: "1-2", position: (0.0, 0.0), heading_deg: 0.0),
                (callsign: "1-3A", squad: "rifle_squad_b", mounted_in: "1-3", position: (0.0, 0.0), heading_deg: 0.0),
            ],
            ai: (tasks: [
