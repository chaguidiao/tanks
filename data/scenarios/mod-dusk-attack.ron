                (callsign: "3-2", vehicle: "ward_m2", position: (1370.0, 1270.0), heading_deg: 45.0, platoon: "3"),
                (callsign: "3-3", vehicle: "ward_m2", position: (1440.0, 1240.0), heading_deg: 45.0, platoon: "3"),
            ],
            ai: (tasks: [
