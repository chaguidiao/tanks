                (callsign: "2-3", vehicle: "bulwark_a2", position: (1840.0, 1690.0), heading_deg: 45.0, platoon: "2"),
                (callsign: "2-4", vehicle: "bulwark_a2", position: (1910.0, 1660.0), heading_deg: 45.0, platoon: "2"),
