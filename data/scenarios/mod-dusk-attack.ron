// M7e Modern scenario (2005): Blue attacks a prepared Red defence at dusk across open farmland.
// Both sides have thermal imagers, so engagements start at 3 km and more. The T-90's gun-launched
// missiles reach 5 km and its reactive armour defeats much of what the Blue infantry fighting
// vehicles can throw; the A2 outranges and out-protects it frontally. Blue wins by seizing the
// village (2 minutes uncontested) within 40 minutes. The player commands the attack; the Red AI
// defends with alternate positions and a reserve. The Blue AI plan is used only when the side is
// not player-controlled (headless runs, tests).
(
    id: "mod-dusk-attack",
    name: "DUSK ATTACK",
    date: (2005, 10, 3),
    start_time_s: 63000, // 17:30
    map: (id: "demo", recipe: "rolling-farmland", seed: 42, size_m: 8000.0),
    seed: 4,
    weather: (preset: "clear", latitude_deg: 50.0, wind_speed_mps: 2.0, wind_from_deg: 290.0, moon_phase: 0.2),
    briefing: "SITUATION: A RED TANK COMPANY (T-90A, T-72B) AND AN INFANTRY FIGHTING VEHICLE PLATOON HOLD A VILLAGE ON OPEN FARMLAND. A RED RESERVE OF T-90A IS BEHIND IT. BOTH SIDES HAVE THERMAL IMAGERS; RED TANKS CARRY GUN-LAUNCHED MISSILES (UP TO 5 KM) AND HEAVY REACTIVE ARMOUR. A 155 MM BATTERY (ARTY 1) IS IN DIRECT SUPPORT.\n\nMISSION: 1ST AND 2ND PLATOONS (M1A2) AND 3RD PLATOON (M2A2) SEIZE THE VILLAGE WITHIN 40 MINUTES. A SIDE THAT LOSES 70 % OF ITS VEHICLES LOSES.\n\nNOTES: THERE IS NO COVER ON THE APPROACH. USE SMOKE TO BREAK THE RED MISSILE ENGAGEMENT, MOVE IN BOUNDS, AND AIM FOR THE SIDES OF THE T-90A; ITS FRONT IS REACTIVE ARMOUR OVER COMPOSITE.",
    objectives: [(name: "VILLAGE", centre: (4500.0, 4300.0), radius_m: 350.0)],
    victory: (time_limit_s: 2400.0, objective: "VILLAGE", attacker: 0, destroyed_fraction: 0.7),
    sides: [
        (
            name: "BLUE",
            doctrine: "western-combined",
            fire_support: [(callsign: "ARTY 1", battery: "sph155_btry", position: (900.0, 700.0))],
            units: [
                (callsign: "1-1", vehicle: "bulwark_a2", position: (1500.0, 1500.0), heading_deg: 45.0, platoon: "1"),
                (callsign: "1-2", vehicle: "bulwark_a2", position: (1570.0, 1470.0), heading_deg: 45.0, platoon: "1"),
                (callsign: "1-3", vehicle: "bulwark_a2", position: (1640.0, 1440.0), heading_deg: 45.0, platoon: "1"),
                (callsign: "1-4", vehicle: "bulwark_a2", position: (1710.0, 1410.0), heading_deg: 45.0, platoon: "1"),
                (callsign: "2-1", vehicle: "bulwark_a2", position: (1700.0, 1750.0), heading_deg: 45.0, platoon: "2"),
