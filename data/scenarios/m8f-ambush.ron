                (callsign: "3-2", vehicle: "ward_m2", position: (6640.0, 4360.0), heading_deg: 270.0, platoon: "3"),
                (callsign: "3-3", vehicle: "ward_m2", position: (6640.0, 4240.0), heading_deg: 270.0, platoon: "3"),
