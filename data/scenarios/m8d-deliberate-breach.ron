                (callsign: "1-2", vehicle: "bulwark_a1", position: (890.0, 1630.0), heading_deg: 90.0, platoon: "1"),
                (callsign: "1-3", vehicle: "bulwark_a1", position: (880.0, 1560.0), heading_deg: 90.0, platoon: "1"),
