                (callsign: "2-1", vehicle: "bulwark_a1", position: (1100.0, 1900.0), heading_deg: 90.0, platoon: "2", kit: "roller_b"),
                (callsign: "2-2", vehicle: "bulwark_a1", position: (1090.0, 1830.0), heading_deg: 90.0, platoon: "2"),
