                (callsign: "3-2", vehicle: "ward_m2", position: (3570.0, 2890.0), heading_deg: 45.0, platoon: "3"),
                (callsign: "3-3", vehicle: "ward_m2", position: (3640.0, 2880.0), heading_deg: 45.0, platoon: "3"),
            ],
            ai: (tasks: [
                (platoons: ["1", "2"], mission: Defend(centre: (4200.0, 4000.0), radius_m: 250.0, facing_deg: 45.0,
                    alternates: [(centre: (3900.0, 3500.0), radius_m: 220.0, facing_deg: 45.0)])),
                (platoons: ["3"], mission: Reserve(assembly: (centre: (3500.0, 2900.0), radius_m: 150.0, facing_deg: 45.0), objective: "VILLAGE")),
