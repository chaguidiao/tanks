                (callsign: "1-2", vehicle: "bulwark_a2", position: (3760.0, 2990.0), heading_deg: 45.0, platoon: "1"),
                (callsign: "1-3", vehicle: "bulwark_a2", position: (3820.0, 2980.0), heading_deg: 45.0, platoon: "1"),
