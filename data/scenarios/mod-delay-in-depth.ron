// M7e Modern scenario (2005): an outnumbered Blue team delays a Red regiment's advance guard in
// wooded uplands from successive positions, with a reserve held back for the village. Red leads
// with a reconnaissance platoon and attacks from an assault position under 152 mm fire. Play as
// Blue; the Blue AI plan is used only when the side is not player-controlled (headless runs,
// tests).
(
    id: "mod-delay-in-depth",
    name: "DELAY IN DEPTH",
    date: (2005, 4, 8),
    start_time_s: 36000, // 10:00
    map: (id: "uplands", recipe: "wooded-uplands", seed: 42, size_m: 8000.0),
    seed: 12,
    weather: (preset: "haze", latitude_deg: 50.0, wind_speed_mps: 3.0, wind_from_deg: 240.0),
    briefing: "SITUATION: THE ADVANCE GUARD OF A RED TANK REGIMENT (T-90A, T-72B, BMP-2) APPROACHES FROM THE NORTH-EAST. RED RECONNAISSANCE LEADS THE MAIN BODY BY SEVERAL KILOMETRES; A 152 MM BATTERY SUPPORTS.\n\nMISSION: 1ST AND 2ND PLATOONS (M1A2) DELAY FROM THE FORWARD POSITIONS, DISPLACE TO THE VILLAGE WHEN PRESSED AND HOLD IT FOR 40 MINUTES. 3RD PLATOON (M2A2, TOW-2) IS THE RESERVE. A SIDE THAT LOSES 70 % OF ITS VEHICLES LOSES.\n\nNOTES: DO NOT LET THE FORWARD PLATOONS BE FIXED; MOVE ON THE TRIGGER, NOT WHEN THE FIRST VEHICLE IS LOST. THE FORESTED SLOPES ARE YOUR BEST COVER.",
    objectives: [(name: "VILLAGE", centre: (3840.0, 3370.0), radius_m: 300.0)],
    victory: (time_limit_s: 2400.0, objective: "VILLAGE", attacker: 1, destroyed_fraction: 0.7),
    sides: [
        (
            name: "BLUE",
            doctrine: "western-combined",
            fire_support: [(callsign: "ARTY 1", battery: "sph155_btry", position: (2800.0, 1500.0))],
            units: [
