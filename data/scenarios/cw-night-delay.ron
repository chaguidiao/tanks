// M7e Cold War scenario (1987): a night delay. Blue's thermal sights see farther than the Red
// tanks' active-IR sights (about 0.9 km), but Red has the numbers and an artillery battery. Blue
// holds forward positions, displaces to the village on the doctrine trigger and keeps a reserve
// that counter-attacks when the village is contested. Play as Blue; the Blue AI plan is used only
// when the side is not player-controlled (headless runs, tests).
(
    id: "cw-night-delay",
    name: "NIGHT DELAY",
    date: (1987, 6, 15),
    start_time_s: 5400, // 01:30
    map: (id: "uplands", recipe: "wooded-uplands", seed: 7, size_m: 8000.0),
    seed: 7,
    weather: (preset: "clear", latitude_deg: 50.0, wind_speed_mps: 1.0, wind_from_deg: 270.0, moon_phase: 0.3),
    briefing: "SITUATION: RED ADVANCES FROM THE NORTH-EAST UNDER A HALF MOON. ITS TANKS FIGHT WITH ACTIVE INFRARED SIGHTS (ABOUT 900 M); YOURS HAVE THERMAL IMAGERS. A RED 152 MM BATTERY SUPPORTS THE ATTACK AND A SMALL RECONNAISSANCE ELEMENT LEADS.\n\nMISSION: 1ST AND 2ND PLATOONS DELAY FROM THE FORWARD POSITIONS AND FALL BACK TO THE VILLAGE WHEN PRESSED. 3RD PLATOON (M2 BRADLEY) IS THE RESERVE: COMMIT IT WHEN THE VILLAGE IS CONTESTED. HOLD THE VILLAGE FOR 40 MINUTES. A SIDE THAT LOSES 70 % OF ITS VEHICLES LOSES.\n\nNOTES: ENGAGE AT RANGES RED CANNOT ANSWER, THEN BREAK CONTACT BEFORE IT CLOSES TO 1 KM. EXPECT ARTILLERY ON YOUR FIRST POSITIONS.",
    objectives: [(name: "VILLAGE", centre: (3840.0, 3370.0), radius_m: 300.0)],
    victory: (time_limit_s: 2400.0, objective: "VILLAGE", attacker: 1, destroyed_fraction: 0.7),
    sides: [
        (
            name: "BLUE",
            doctrine: "western-combined",
            fire_support: [(callsign: "ARTY 1", battery: "sph155_btry", position: (2800.0, 1500.0))],
            units: [
                (callsign: "1-1", vehicle: "bulwark_a0", position: (3700.0, 3000.0), heading_deg: 45.0, platoon: "1"),
                (callsign: "1-2", vehicle: "bulwark_a0", position: (3760.0, 2990.0), heading_deg: 45.0, platoon: "1"),
                (callsign: "1-3", vehicle: "bulwark_a0", position: (3820.0, 2980.0), heading_deg: 45.0, platoon: "1"),
                (callsign: "1-4", vehicle: "bulwark_a0", position: (3880.0, 2970.0), heading_deg: 45.0, platoon: "1"),
                (callsign: "2-1", vehicle: "bulwark_a0", position: (3950.0, 3000.0), heading_deg: 45.0, platoon: "2"),
                (callsign: "2-2", vehicle: "bulwark_a0", position: (4010.0, 2990.0), heading_deg: 45.0, platoon: "2"),
                (callsign: "2-3", vehicle: "bulwark_a0", position: (4070.0, 2980.0), heading_deg: 45.0, platoon: "2"),
                (callsign: "2-4", vehicle: "bulwark_a0", position: (4130.0, 2970.0), heading_deg: 45.0, platoon: "2"),
                (callsign: "3-1", vehicle: "ward_m2", position: (3500.0, 2900.0), heading_deg: 45.0, platoon: "3"),
                (callsign: "3-2", vehicle: "ward_m2", position: (3570.0, 2890.0), heading_deg: 45.0, platoon: "3"),
                (callsign: "3-3", vehicle: "ward_m2", position: (3640.0, 2880.0), heading_deg: 45.0, platoon: "3"),
            ],
            ai: (tasks: [
                (platoons: ["1", "2"], mission: Defend(centre: (4200.0, 4000.0), radius_m: 250.0, facing_deg: 45.0,
                    alternates: [(centre: (3900.0, 3500.0), radius_m: 220.0, facing_deg: 45.0)])),
                (platoons: ["3"], mission: Reserve(assembly: (centre: (3500.0, 2900.0), radius_m: 150.0, facing_deg: 45.0), objective: "VILLAGE")),
            ]),
        ),
        (
            name: "RED",
            doctrine: "generic-opfor",
            fire_support: [(callsign: "ARTY 2", battery: "sph152_btry", position: (7600.0, 7200.0))],
            units: [
