            ],
            ai: (tasks: [
                (platoons: ["27"], mission: Recon(axis: [(5800.0, 5400.0), (5000.0, 4600.0)],
                    observe: (centre: (4800.0, 4400.0), radius_m: 120.0, facing_deg: 225.0))),
                (platoons: ["21", "22", "23", "24", "25", "26"], release_on_contact: true, latest_s: 600.0,
                 mission: Attack(axis: [(5800.0, 5400.0), (4800.0, 4400.0)], objective: "VILLAGE")),
            ]),
