                (callsign: "242", vehicle: "kurgan_b", position: (7160.0, 6620.0), heading_deg: 225.0, platoon: "24"),
                (callsign: "243", vehicle: "kurgan_b", position: (7220.0, 6680.0), heading_deg: 225.0, platoon: "24"),
                (callsign: "251", vehicle: "skif_m1", position: (7300.0, 6680.0), heading_deg: 225.0, platoon: "25"),
                (callsign: "252", vehicle: "skif_m1", position: (7360.0, 6740.0), heading_deg: 225.0, platoon: "25"),
                (callsign: "253", vehicle: "skif_m1", position: (7420.0, 6800.0), heading_deg: 225.0, platoon: "25"),
