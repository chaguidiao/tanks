// Fictional Red MBT mirroring the Soviet T-80B (1978; T-80BV with reactive armour from 1985):
// gas-turbine engine, 125 mm gun that also fires a radio-command missile, laser rangefinder sight
// with a ballistic computer, no thermal sight. Still in Russian service in the 2000s, so it has no
// end date (later thermal upgrades are outside the data's years and are not modelled).
// Values from public sources; most are open-source summaries (confidence low) or estimates.
// Sabot: as kholm_b, the 3BM22-class round before 1986 and the 3BM42-class round after; from
// 1986 both are stocked.
(
    id: "uval_b",
    name: "UVAL-B",
    mirrors: "T-80B/BV",
    in_service: (from: 1978),
    class: mbt,
    dimensions: (
        hull_length_m: (value: 7.0, source: "estimate", confidence: estimate,
            notes: "Open summaries give 7.0-7.4 m; the hull is a little longer than the T-64's (6.54 m) for the turbine."),
        width_m: (value: 3.4, source: "open-source summaries (Wikipedia, T-80, 2026): T-80B 3.4 m", confidence: low),
        height_m: (value: 2.2, source: "open-source summaries (Wikipedia, T-80, 2026): T-80B 2.202 m", confidence: medium),
        hull_height_m: (value: 1.4, source: "estimate from published side views", confidence: estimate,
            notes: "Same height class as the T-64 and T-72."),
        sight_height_m: (value: 2.0, source: "estimate from published side views", confidence: estimate,
            notes: "Gunner's sight head on the turret roof, as on the T-64."),
    ),
    mobility: (
        combat_mass_kg: (value: 42500.0, source: "open-source summaries (Wikipedia, T-80, 2026): T-80B 42.5 t", confidence: low,
            notes: "The BV's tiles add about a tonne; mass is not dated in the data."),
        engine_power_w: (value: 736000.0, source: "open-source summaries (Wikipedia, T-80, 2026): gas turbine, 1,000 hp", confidence: low,
            notes: "A 1,100 hp turbine followed during production; the earlier rating is used."),
        drivetrain_efficiency: (value: 0.65, source: "estimate", confidence: estimate,
            notes: "Mechanical planetary gearboxes behind a free power turbine; a little below the diesel T-72 (0.70) because the turbine loses power at part load."),
        max_speed_road_mps: (value: 19.4, source: "open-source summaries (Wikipedia, T-80, 2026): 70 km/h", confidence: low),
        max_speed_cross_country_mps: (value: 12.5, source: "open-source summaries (Wikipedia, T-80, 2026): 45-48 km/h off road", confidence: low,
            notes: "Lower value of the range, 45 km/h."),
        max_speed_reverse_mps: (value: 3.0, source: "estimate", confidence: estimate,
            notes: "One reverse gear (Wikipedia, T-80, 2026); open descriptions suggest about 11 km/h, faster than the T-72's because of the turbine's torque at low speed."),
        max_slope: (value: 0.58, source: "estimate", confidence: estimate, notes: "30 deg, as the other Soviet MBTs of the period (FM 100-2-3)."),
        max_side_slope: (value: 0.47, source: "estimate", confidence: estimate, notes: "25 deg, as the other Soviet MBTs of the period (FM 100-2-3)."),
        fording_depth_m: (value: 1.2, source: "estimate", confidence: estimate, notes: "Same unprepared depth as the T-72; open summaries give 1.8 m only for the diesel T-80UD."),
        vertical_step_m: (value: 1.0, source: "estimate", confidence: estimate, notes: "Longer, larger-wheeled running gear than the T-64."),
        trench_width_m: (value: 2.85, source: "estimate", confidence: estimate, notes: "Typical for a hull of this length."),
        track_ground_contact_m: (value: 4.6, source: "estimate", confidence: estimate,
            notes: "Open summaries say the tracks are wider and longer than the T-64's (Wikipedia, T-80, 2026); about 0.8 kgf/cm2."),
        track_width_m: (value: 0.58, source: "estimate", confidence: estimate, notes: "Wider than the T-64's track, same as the T-72's."),
        max_yaw_rate_rad_s: (value: 0.5, source: "estimate", confidence: estimate,
            notes: "Planetary steering with two side gearboxes; same as the T-64 and T-72."),
        max_lateral_accel_mps2: (value: 3.0, source: "Wong, Theory of Ground Vehicles (5th ed.), skid-steering", confidence: estimate,
            notes: "Same limit as other skid-steer hulls; soil dominates."),
        braking_decel_mps2: (value: 4.0, source: "estimate", confidence: estimate, notes: "~0.4 g service braking on firm ground."),
        fuel_capacity_l: (value: 1100.0, source: "open-source summaries (Wikipedia, T-80, 2026): 1,100 L internal, 740 L external", confidence: low),
        fuel_idle_lph: (value: 80.0, source: "estimate", confidence: estimate,
            notes: "Without an auxiliary power unit the turbine burns nearly as much at idle as on the move (Wikipedia, T-80, 2026); set well above a diesel's 15 L/h."),
        fuel_per_kwh_l: (value: 0.45, source: "estimate", confidence: estimate,
            notes: "Early tank gas turbine, SFC ~370 g/kWh, density 0.82 kg/L: about 1.5x a diesel."),
    ),
    gun: (
        depression_rad: (value: -0.0931, source: "estimate", confidence: estimate, notes: "Same 2A46 gun and stabiliser family as the T-64B: -5 deg 20 min."),
        elevation_rad: (value: 0.2662, source: "estimate", confidence: estimate, notes: "Same 2A46 gun and stabiliser family as the T-64B: +15 deg 15 min."),
    ),
    crew: 3,
    sensors: [
        (name: "COMMANDER (UNBUTTONED/PERISCOPES)", kind: optical, in_service: (from: 1970),
            cycles_per_mrad: (value: 1.5, source: "estimate", confidence: estimate, notes: "Same as the other Red tanks.")),
        (name: "1G42-LIKE DAY SIGHT 8X", kind: optical, in_service: (from: 1978),
            cycles_per_mrad: (value: 7.0, source: "estimate", confidence: estimate,
                notes: "Laser rangefinder sight with about 8x magnification; same resolving power as the T-72's.")),
        (name: "ACTIVE IR NIGHT SIGHT", kind: night_channel, in_service: (from: 1978),
            cycles_per_mrad: (value: 0.6, source: "estimate", confidence: estimate, notes: "TPN-3-49 class; same resolving power as the T-72's."),
            max_range_m: (value: 1300.0, source: "open-source summaries (Wikipedia, T-80, 2026): about 1,300 m active, 850 m passive", confidence: low)),
    ],
    fire_control: (
        laser_rangefinder: true,
        laser_range_error_m: (value: 10.0, source: "estimate", confidence: estimate, notes: "Same laser class as the T-64B."),
        estimated_range_error_fraction: (value: 0.12, source: "estimate", confidence: estimate, notes: "Stadiametric fallback, as the T-72."),
        ballistic_error_mrad: (value: 0.25, source: "estimate", confidence: estimate,
            notes: "1A33-class system with a ballistic computer, as the T-64B (data/vehicles/kholm_b.ron)."),
        aim_error_mrad: (value: 0.15, source: "estimate", confidence: estimate, notes: "Same as the T-72."),
        moving_error_mrad: (value: 0.7, source: "estimate", confidence: estimate, notes: "Two-plane stabiliser linked to a stabilised sight, as the T-64B."),
        lead_error_fraction: (value: 0.2, source: "estimate", confidence: estimate, notes: "Lead computed by the fire-control computer, as the T-64B."),
        lay_time_s: (value: 4.0, source: "estimate", confidence: estimate, notes: "Same as the T-72."),
        lase_time_s: (value: 1.5, source: "estimate", confidence: estimate, notes: "Same as the T-72."),
    ),
    armament: (
        gun: "125 MM SMOOTHBORE + ATGM",
        load: [(ammo: "apfsds_125b", count: 10), (ammo: "apfsds_125a", count: 10), (ammo: "atgm_kobra", count: 4), (ammo: "hefrag_125", count: 12), (ammo: "heat_125", count: 6)],
        autoloader: true,
        reload_s: (value: 7.1, source: "open-source summaries (Wikipedia, T-80, 2026): carousel loader 7.1 s for the nearest round", confidence: low,
            notes: "A far round takes up to 19.5 s, a sequence of one type less; the nearest-round figure matches the T-72's here."),
        turret_traverse_rad_s: (value: 0.33, source: "estimate", confidence: estimate, notes: "Same turret drive class as the T-64B."),
        max_engagement_range_m: (value: 4000.0, source: "estimate", confidence: estimate, notes: "The missile's reach; each round type carries its own limit."),
    ),
    coax: (name: "7.62 MM COAX (PKT)", count: 1,
        rounds_per_burst: (value: 10.0, source: "FM 3-22.68 (2003): coax bursts of about 10-20 rounds; estimate", confidence: low),
        burst_interval_s: (value: 5.0, source: "FM 3-22.68 (2003): sustained fire about 100 rounds/min", confidence: low),
        max_range_m: (value: 900.0, source: "FM 3-22.68 (2003): 7.62 mm tracer burnout about 900 m", confidence: medium),
        dispersion_mrad: (value: 2.0, source: "estimate", confidence: estimate, notes: "Rigid mount laid through the gunner's sight; beaten zone of the burst dominates."),
        bursts: 125),  // Zaloga, T-80 (Osprey): 1,250 rounds of 7.62 mm; bursts of 10
    armour: (
        ce_factor: (value: 1.3, source: "open-source summaries (Wikipedia, T-80, 2026): turret front 500 mm vs KE, 650 mm vs HEAT", confidence: estimate,
            notes: "Ratio of the turret's CE to KE figures."),
        era: (
            in_service: (from: 1985),
            tiles: 90,
            coverage: (value: 0.7, source: "estimate: tiles cover the glacis, turret front and side skirts but not every spot", confidence: estimate,
                notes: "Same first-generation fit as kurgan_b."),
            ce_defeat: (value: 0.6, source: "open-source estimates: first-generation ERA (Kontakt-1 class) cuts HEAT penetration by roughly half to two thirds", confidence: low),
            ke_gain_mm: (value: 15.0, source: "open-source estimates: first-generation ERA adds little against long-rod penetrators", confidence: low),
        ),
        turret_front: (value: 500.0, source: "open-source summaries (Wikipedia, T-80, 2026): T-80B turret front about 500 mm vs KE", confidence: estimate,
            notes: "Cast turret with a thicker special-armour insert than the T-64B's."),
        turret_side: (value: 110.0, source: "estimate", confidence: estimate, notes: "Same as the T-72."),
        turret_rear: (value: 60.0, source: "estimate", confidence: estimate, notes: "Same as the T-72."),
        hull_front: (value: 445.0, source: "open-source summaries (Wikipedia, T-80, 2026): hull front 440-450 mm vs KE", confidence: estimate),
        hull_side: (value: 80.0, source: "estimate", confidence: estimate, notes: "Same as the T-72."),
        hull_rear: (value: 40.0, source: "estimate", confidence: estimate, notes: "Same as the T-72."),
    ),
    ammo_stowage: exposed,
    smoke_launcher: (
        kinds: ["grenade"],
        salvos: 1,
        clouds_per_salvo: 4,
        range_m: (value: 50.0, source: "estimate", confidence: estimate, notes: "902-series 81 mm launchers on the turret, as on the T-72."),
        arc_deg: (value: 70.0, source: "estimate", confidence: estimate, notes: "Tubes fixed in a fan on the turret front; fires one salvo per reload."),
    ),
    engine_smoke: (kinds: ["engine"]),
)
