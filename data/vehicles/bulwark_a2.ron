// Fictional Blue MBT mirroring the US M1A2 SEP Abrams (about 2005): commander's independent
// thermal viewer, second-generation gunner's thermal imager, improved armour.
// Values transcribed from public sources; verify against the cited edition before tuning.
(
    id: "bulwark_a2",
    name: "BULWARK A2",
    mirrors: "M1A2 SEP Abrams",
    in_service: (from: 2000),
    class: mbt,
    dimensions: (
        hull_length_m: (value: 7.92, source: "Hunnicutt, Abrams (1990), M1A1 characteristics", confidence: high),
        width_m: (value: 3.66, source: "Hunnicutt, Abrams (1990)", confidence: high),
        height_m: (value: 2.44, source: "Hunnicutt, Abrams (1990), turret roof", confidence: high),
        hull_height_m: (value: 1.55, source: "estimate from published side views", confidence: estimate),
        sight_height_m: (value: 2.3, source: "estimate from published side views", confidence: estimate),
    ),
    mobility: (
        combat_mass_kg: (value: 63100.0, source: "open editions of Jane's Armour and Artillery: M1A2 SEP about 63 t", confidence: medium),
        engine_power_w: (value: 1119000.0, source: "Hunnicutt, Abrams (1990): AGT1500, 1,500 hp", confidence: high),
        drivetrain_efficiency: (value: 0.65, source: "Ogorkiewicz, Technology of Tanks (1991), transmission losses", confidence: estimate,
            notes: "Hydrokinetic transmission plus final drives and track losses; chosen so the power-limited speed on firm ground is near the governed speed."),
        max_speed_road_mps: (value: 18.6, source: "open editions of Jane's Armour and Artillery: governed 67 km/h", confidence: medium),
        max_speed_cross_country_mps: (value: 13.4, source: "Hunnicutt, Abrams (1990): 30 mph cross-country", confidence: medium),
        max_speed_reverse_mps: (value: 4.9, source: "Zaloga, M1 Abrams Main Battle Tank (Osprey); public sources give about 16-20 km/h", confidence: medium, notes: "Corrected from 11.1 m/s (40 km/h), which is implausible for a reverse gear; reverse driving is now used by the REVERSE order."),
        max_slope: (value: 0.60, source: "Hunnicutt, Abrams (1990): 60% gradient", confidence: high),
        max_side_slope: (value: 0.40, source: "Hunnicutt, Abrams (1990): 40% side slope", confidence: high),
        fording_depth_m: (value: 1.22, source: "Hunnicutt, Abrams (1990): 48 in unprepared", confidence: high),
        vertical_step_m: (value: 1.07, source: "Hunnicutt, Abrams (1990): 42 in", confidence: high),
        trench_width_m: (value: 2.74, source: "Hunnicutt, Abrams (1990): 9 ft", confidence: high),
        track_ground_contact_m: (value: 4.62, source: "Hunnicutt, Abrams (1990)", confidence: medium),
        track_width_m: (value: 0.635, source: "Hunnicutt, Abrams (1990): T156/T158 track, 25 in", confidence: high),
        max_yaw_rate_rad_s: (value: 0.6, source: "estimate", confidence: estimate,
            notes: "~34 deg/s pivot; a full pivot in roughly 10 s is typical of modern skid-steer MBTs."),
        max_lateral_accel_mps2: (value: 3.0, source: "Wong, Theory of Ground Vehicles (5th ed.), skid-steering", confidence: estimate,
            notes: "Lateral resistance limits skid-steer turns at speed; ~0.3 g keeps turns plausible on firm soil."),
        braking_decel_mps2: (value: 4.0, source: "estimate", confidence: estimate, notes: "~0.4 g service braking on firm ground."),
        fuel_capacity_l: (value: 1908.0, source: "Hunnicutt, Abrams (1990): 504.5 US gal", confidence: high),
        fuel_idle_lph: (value: 38.0, source: "Zaloga, M1 Abrams (Osprey): ~10 gal/h at idle", confidence: medium),
        fuel_per_kwh_l: (value: 0.37, source: "estimate", confidence: estimate,
            notes: "AGT1500 SFC ~0.5 lb/hp-h at full power = 0.30 kg/kWh; JP-8 density 0.80 kg/L."),
    ),
    gun: (
        depression_rad: (value: -0.1745, source: "Hunnicutt, Abrams (1990): -10 deg", confidence: high),
        elevation_rad: (value: 0.3491, source: "Hunnicutt, Abrams (1990): +20 deg", confidence: high),
    ),
    crew: 4,
    sensors: [
        (name: "COMMANDER (UNBUTTONED/PERISCOPES)", kind: optical, in_service: (from: 1980),
            cycles_per_mrad: (value: 1.5, source: "estimate", confidence: estimate,
                notes: "Eye ~1 arcmin acuity ≈ 1.7 cycles/mrad; periscopes and wide search lower it.")),
        (name: "GPS DAY 10X", kind: optical, in_service: (from: 1980),
            cycles_per_mrad: (value: 8.0, source: "Driggers et al., Intro to IR and EO Systems (2012), magnified optics", confidence: estimate,
                notes: "10x optic with eye acuity, reduced for vibration and atmosphere.")),
        (name: "CITV THERMAL", kind: thermal, in_service: (from: 1992),
            cycles_per_mrad: (value: 4.5, source: "Vollmerhausen & Jacobs (2004); commander's independent thermal viewer, first-generation common-module class", confidence: estimate)),
        (name: "GUNNER THERMAL (GEN 2)", kind: thermal, in_service: (from: 2000),
            cycles_per_mrad: (value: 5.5, source: "Vollmerhausen & Jacobs (2004); second-generation staring/common-module FLIR", confidence: estimate,
                notes: "Better than the first-generation scanning imager of the Cold War M1.")),
    ],
    fire_control: (
        laser_rangefinder: true,
        laser_range_error_m: (value: 5.0, source: "Ogorkiewicz, Technology of Tanks (1991), Nd:YAG rangefinders", confidence: medium),
        estimated_range_error_fraction: (value: 0.1, source: "Ogorkiewicz (1991), stadiametric ranging", confidence: estimate),
        ballistic_error_mrad: (value: 0.1, source: "Driels, Weaponeering (2013), error budgets; estimate", confidence: estimate),
        aim_error_mrad: (value: 0.08, source: "estimate", confidence: estimate),
        moving_error_mrad: (value: 0.2, source: "estimate", confidence: estimate, notes: "Two-axis stabilised gun with stabilised sight."),
        lead_error_fraction: (value: 0.1, source: "estimate", confidence: estimate, notes: "Automatic lead from a rate sensor."),
        lay_time_s: (value: 2.0, source: "TC 3-20.31 crew engagement standards (order of magnitude)", confidence: estimate),
        lase_time_s: (value: 1.0, source: "estimate", confidence: estimate),
    ),
    armament: (
        gun: "120 MM SMOOTHBORE",
        load: [(ammo: "apfsds_120b", count: 22), (ammo: "heat_120a", count: 15), (ammo: "smoke_120", count: 3)],
        autoloader: false,
        reload_s: (value: 6.0, source: "estimate", confidence: estimate, notes: "Trained human loader from the ready rack."),
        turret_traverse_rad_s: (value: 0.7, source: "Hunnicutt, Abrams (1990): 360 deg in ~9 s", confidence: medium),
        max_engagement_range_m: (value: 3500.0, source: "estimate", confidence: estimate),
    ),
    armour: (
        ce_factor: (value: 1.8, source: "open-source estimates: composite armour yields roughly 1.5-2x RHA against shaped charges relative to KE", confidence: estimate),
        turret_front: (value: 760.0, source: "open-source estimates (range ~650-900 mm vs KE)", confidence: estimate,
            notes: "Third-generation composite with depleted-uranium mesh; public estimates vary widely."),
        turret_side: (value: 150.0, source: "estimate", confidence: estimate),
        turret_rear: (value: 60.0, source: "estimate", confidence: estimate),
        hull_front: (value: 600.0, source: "open-source estimates (range ~500-700 mm vs KE)", confidence: estimate),
        hull_side: (value: 70.0, source: "estimate", confidence: estimate, notes: "Side skirts plus hull side."),
        hull_rear: (value: 40.0, source: "estimate", confidence: estimate),
    ),
    ammo_stowage: isolated,
    smoke_launcher: (
        kinds: ["grenade_ms", "grenade"],
        salvos: 2,
        clouds_per_salvo: 3,
        range_m: (value: 30.0, source: "Hunnicutt, Abrams (1990): turret-mounted grenade launchers (two banks of six), burst 30-40 m out", confidence: low),
        arc_deg: (value: 60.0, source: "estimate", confidence: estimate, notes: "Two banks fan across the turret's forward arc."),
    ),
)
