// Fictional Blue ammunition (cargo) truck mirroring the M977 HEMTT cargo truck (1982).
// Supply vehicle for tailgate resupply (docs/plans/M8C-TAILGATE-TRUCKS.md): unarmed, soft-skinned.
// Wheeled mobility is approximated with the tracked model: an equivalent contact patch that gives
// a tyre ground pressure of about 250 kPa, and a low cross-country speed (TODO ENG wheeled model).
(
    id: "carter_c",
    name: "CARTER C",
    mirrors: "M977 HEMTT cargo truck",
    in_service: (from: 1982),
    class: support,
    dimensions: (
        hull_length_m: (value: 10.2, source: "Jane's Military Vehicles and Logistics (open editions)", confidence: low),
        width_m: (value: 2.44, source: "Jane's Military Vehicles and Logistics (open editions)", confidence: low),
        height_m: (value: 2.6, source: "Jane's Military Vehicles and Logistics (open editions)", confidence: low),
        hull_height_m: (value: 2.2, source: "estimate", confidence: estimate, notes: "Cab and body roof; the whole truck is a soft target."),
        sight_height_m: (value: 2.3, source: "estimate", confidence: estimate, notes: "Driver's eye height in a forward-control cab."),
    ),
    mobility: (
        combat_mass_kg: (value: 28000.0, source: "Jane's Military Vehicles and Logistics (open editions): gross vehicle weight, loaded", confidence: low),
        engine_power_w: (value: 332000.0, source: "Jane's Military Vehicles and Logistics (open editions): Detroit Diesel 8V92TA, 445 hp", confidence: low),
        drivetrain_efficiency: (value: 0.8, source: "estimate", confidence: estimate, notes: "Wheeled drivetrain, no tracks to drive."),
        max_speed_road_mps: (value: 25.0, source: "Jane's Military Vehicles and Logistics (open editions)", confidence: low),
        max_speed_cross_country_mps: (value: 7.0, source: "estimate", confidence: estimate, notes: "A loaded truck off road: about 25-30 km/h on good open ground."),
        max_speed_reverse_mps: (value: 4.0, source: "estimate", confidence: estimate),
        max_slope: (value: 0.6, source: "Jane's Military Vehicles and Logistics (open editions): about 30 deg (60 %) gradient", confidence: low),
        max_side_slope: (value: 0.3, source: "estimate", confidence: estimate, notes: "Wheeled trucks with a high load tip over sooner than tanks."),
        fording_depth_m: (value: 1.2, source: "Jane's Military Vehicles and Logistics (open editions)", confidence: low),
        vertical_step_m: (value: 0.5, source: "estimate", confidence: estimate),
        trench_width_m: (value: 0.6, source: "estimate", confidence: estimate, notes: "Wheels drop into a trench a tank would span."),
        track_ground_contact_m: (value: 1.4, source: "estimate", confidence: estimate, notes: "Equivalent: mass x g / 250 kPa over two strips of the width below."),
        track_width_m: (value: 0.4, source: "estimate", confidence: estimate, notes: "Equivalent strip width, about a tyre width."),
        max_yaw_rate_rad_s: (value: 0.3, source: "estimate", confidence: estimate, notes: "No pivot turn; a turning circle of 20-25 m at walking pace."),
        max_lateral_accel_mps2: (value: 3.0, source: "estimate", confidence: estimate),
        braking_decel_mps2: (value: 5.0, source: "estimate", confidence: estimate),
        fuel_capacity_l: (value: 590.0, source: "Jane's Military Vehicles and Logistics (open editions): own fuel tank", confidence: low),
        fuel_idle_lph: (value: 4.0, source: "estimate", confidence: estimate),
        fuel_per_kwh_l: (value: 0.26, source: "estimate", confidence: estimate, notes: "Truck diesel, about 220 g/kWh at density 0.84 kg/L."),
    ),
    gun: (
        depression_rad: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        elevation_rad: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
    ),
    crew: 2,
    sensors: [
        (name: "DRIVER AND CO-DRIVER (WINDSCREEN)", kind: optical, in_service: (from: 1982),
            cycles_per_mrad: (value: 1.5, source: "estimate", confidence: estimate, notes: "Unaided eyes, as a tank commander unbuttoned.")),
    ],
    fire_control: (
        laser_rangefinder: false,
        laser_range_error_m: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        estimated_range_error_fraction: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        ballistic_error_mrad: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        aim_error_mrad: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        moving_error_mrad: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        lead_error_fraction: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        lay_time_s: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        lase_time_s: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
