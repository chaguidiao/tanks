        reload_s: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        turret_traverse_rad_s: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        max_engagement_range_m: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
    ),
    armour: (
        ce_factor: (value: 1.0, source: "estimate", confidence: estimate),
        turret_front: (value: 4.0, source: "estimate", confidence: estimate, notes: "No turret: the cab. Sheet steel, proof against nothing."),
        turret_side: (value: 3.0, source: "estimate", confidence: estimate),
        turret_rear: (value: 3.0, source: "estimate", confidence: estimate),
        hull_front: (value: 5.0, source: "estimate", confidence: estimate, notes: "Engine block and cab front."),
        hull_side: (value: 3.0, source: "estimate", confidence: estimate),
        hull_rear: (value: 3.0, source: "estimate", confidence: estimate),
        top: (value: 2.0, source: "estimate", confidence: estimate),
    ),
    ammo_stowage: exposed,
    cargo: (
        payload_kg: (value: 9100.0, source: "Jane's Military Vehicles and Logistics (open editions): rated payload", confidence: low),
        fuel_l: (value: 0.0, source: "carries no bulk fuel", confidence: high),
        main_gun_rounds: 160,
        autocannon_rounds: 2400,
        missiles: 16,
        smoke_salvos: 16,
    ),
    // Cargo rounds (estimate): about 27 kg per packed main-gun round (two-round containers), 1 kg per packed autocannon round, 30 kg per missile in its container: 160 x 27 + 2400 x 1 + 16 x 30 = 7.2 t of the 9.1 t payload, the rest dunnage and smoke grenades.
)
