// Fictional Blue armoured recovery vehicle mirroring the M88A1 (1977), on an M48/M60-class hull.
// Recovery vehicle (docs/plans/M8C-RECOVERY.md): tows immobilised vehicles to the collection point.
// Its pintle machine gun is for self-defence and is left out, as the trucks' weapons are.
(
    id: "hawser_a1",
    name: "HAWSER A1",
    mirrors: "M88A1 armoured recovery vehicle",
    in_service: (from: 1977),
    class: recovery,
    dimensions: (
        hull_length_m: (value: 8.27, source: "Hunnicutt, Patton: A History of the American Main Battle Tank (1984): M88A1", confidence: low),
        width_m: (value: 3.43, source: "Hunnicutt, Patton (1984): M88A1", confidence: low),
        height_m: (value: 3.13, source: "Hunnicutt, Patton (1984): M88A1, to the top of the crew compartment with the A-frame stowed", confidence: low),
        hull_height_m: (value: 2.4, source: "estimate from published side views", confidence: estimate, notes: "Tall box superstructure; no turret."),
        sight_height_m: (value: 2.9, source: "estimate from published side views", confidence: estimate, notes: "Commander's cupola on the crew compartment roof."),
    ),
    mobility: (
        combat_mass_kg: (value: 50800.0, source: "Hunnicutt, Patton (1984): M88A1 combat loaded, about 50.8 t", confidence: low),
        engine_power_w: (value: 559000.0, source: "Hunnicutt, Patton (1984): Continental AVDS-1790-2DR, 750 hp", confidence: low),
        drivetrain_efficiency: (value: 0.65, source: "Ogorkiewicz, Technology of Tanks (1991)", confidence: estimate, notes: "Cross-drive hydrokinetic transmission of the M48/M60 family."),
        max_speed_road_mps: (value: 11.7, source: "Hunnicutt, Patton (1984): 42 km/h", confidence: low),
        max_speed_cross_country_mps: (value: 7.0, source: "estimate", confidence: estimate, notes: "About 25 km/h: a heavy vehicle with a modest power to weight ratio (11 kW/t)."),
        max_speed_reverse_mps: (value: 3.0, source: "estimate", confidence: estimate),
        max_slope: (value: 0.6, source: "Hunnicutt, Patton (1984): 60 % gradient", confidence: low),
        max_side_slope: (value: 0.4, source: "estimate", confidence: estimate),
        fording_depth_m: (value: 1.42, source: "Hunnicutt, Patton (1984)", confidence: low),
        vertical_step_m: (value: 1.07, source: "Hunnicutt, Patton (1984)", confidence: low),
        trench_width_m: (value: 2.61, source: "Hunnicutt, Patton (1984)", confidence: low),
        track_ground_contact_m: (value: 4.6, source: "estimate", confidence: estimate, notes: "M48/M60-class running gear, six road wheels a side."),
        track_width_m: (value: 0.71, source: "estimate", confidence: estimate, notes: "M48/M60-class track, 28 in."),
        max_yaw_rate_rad_s: (value: 0.45, source: "estimate", confidence: estimate),
        max_lateral_accel_mps2: (value: 3.0, source: "Wong, Theory of Ground Vehicles (5th ed.), skid-steering", confidence: estimate),
        braking_decel_mps2: (value: 4.0, source: "estimate", confidence: estimate),
        fuel_capacity_l: (value: 1500.0, source: "Hunnicutt, Patton (1984): about 400 US gal", confidence: low),
        fuel_idle_lph: (value: 15.0, source: "estimate", confidence: estimate),
        fuel_per_kwh_l: (value: 0.3, source: "estimate", confidence: estimate, notes: "Air-cooled V12 diesel, about 250 g/kWh at density 0.84 kg/L."),
    ),
    gun: (
        depression_rad: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        elevation_rad: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
    ),
    crew: 3,
    sensors: [
        (name: "COMMANDER (CUPOLA/PERISCOPES)", kind: optical, in_service: (from: 1977),
            cycles_per_mrad: (value: 1.5, source: "estimate", confidence: estimate, notes: "Unaided eyes and unity periscopes, as a tank commander.")),
    ],
    fire_control: (
        laser_rangefinder: false,
        laser_range_error_m: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        estimated_range_error_fraction: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        ballistic_error_mrad: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        aim_error_mrad: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        moving_error_mrad: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        lead_error_fraction: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        lay_time_s: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        lase_time_s: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
    ),
    armament: (
        gun: "NONE",
        load: [],
        autoloader: false,
        reload_s: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        turret_traverse_rad_s: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        max_engagement_range_m: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
    ),
    armour: (
        ce_factor: (value: 1.0, source: "estimate", confidence: estimate, notes: "Plain cast and rolled steel."),
        turret_front: (value: 40.0, source: "estimate", confidence: estimate, notes: "No turret: the crew compartment front. Protection against small arms and fragments only."),
        turret_side: (value: 25.0, source: "estimate", confidence: estimate),
        turret_rear: (value: 25.0, source: "estimate", confidence: estimate),
        hull_front: (value: 60.0, source: "estimate", confidence: estimate, notes: "Cast hull front with the spade; far thinner than a tank's glacis."),
        hull_side: (value: 30.0, source: "estimate", confidence: estimate),
        hull_rear: (value: 25.0, source: "estimate", confidence: estimate),
        top: (value: 20.0, source: "estimate", confidence: estimate),
    ),
    ammo_stowage: exposed,
    recovery: (
        tow_speed_mps: (value: 4.5, source: "estimate", confidence: estimate,
            notes: "About 16 km/h with a tank on the tow bar: towing is done at a walking-to-jogging pace off road and somewhat faster on roads; FM 20-22 (1988) limits towing speeds without giving one figure for every case."),
        rated_tow_kg: (value: 56000.0, source: "estimate from open accounts of the M88A1 and the M1", confidence: low,
            notes: "The M88A1 was designed for the M48/M60 family (about 50 t); open accounts describe it as strained towing the heavier M1 family, which led to the M88A2. 56 t puts the M1A1 just over the rating."),
        hookup_s: (value: 300.0, source: "estimate", confidence: estimate, notes: "Crew dismounts, connects the tow bar and safety chains, checks the towed vehicle's brakes and final drives are released: about 5 min for a trained crew."),
        unhook_s: (value: 120.0, source: "estimate", confidence: estimate),
    ),
)
