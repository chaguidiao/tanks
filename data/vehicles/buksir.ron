// Fictional Red armoured recovery vehicle mirroring the BREM-1 (1984), on a T-72A hull.
// Recovery vehicle (docs/plans/M8C-RECOVERY.md): tows immobilised vehicles to the collection point.
// Its roof machine gun is for self-defence and is left out, as the trucks' weapons are.
(
    id: "buksir",
    name: "BUKSIR",
    mirrors: "BREM-1 armoured recovery vehicle",
    in_service: (from: 1984),
    class: recovery,
    dimensions: (
        hull_length_m: (value: 7.98, source: "Jane's Armour and Artillery (open editions): BREM-1", confidence: low),
        width_m: (value: 3.46, source: "Jane's Armour and Artillery (open editions): BREM-1", confidence: low),
        height_m: (value: 2.43, source: "Jane's Armour and Artillery (open editions): BREM-1", confidence: low),
        hull_height_m: (value: 1.9, source: "estimate from published side views", confidence: estimate, notes: "T-72 hull with a low superstructure in place of the turret."),
        sight_height_m: (value: 2.3, source: "estimate from published side views", confidence: estimate),
    ),
    mobility: (
        combat_mass_kg: (value: 41000.0, source: "Jane's Armour and Artillery (open editions): BREM-1, about 41 t", confidence: low),
        engine_power_w: (value: 618000.0, source: "Jane's Armour and Artillery (open editions): V-84 class diesel, 840 hp", confidence: low),
        drivetrain_efficiency: (value: 0.70, source: "Ogorkiewicz, Technology of Tanks (1991)", confidence: estimate, notes: "As the T-72's mechanical planetary gearboxes."),
        max_speed_road_mps: (value: 16.7, source: "Jane's Armour and Artillery (open editions): 60 km/h", confidence: low),
        max_speed_cross_country_mps: (value: 10.0, source: "estimate", confidence: estimate, notes: "A little below the T-72's cross-country speed."),
        max_speed_reverse_mps: (value: 1.35, source: "FM 100-2-3 (1991): T-72 single reverse gear, about 4.9 km/h", confidence: low),
        max_slope: (value: 0.58, source: "FM 100-2-3 (1991): T-72, 30 deg gradient", confidence: low),
        max_side_slope: (value: 0.47, source: "FM 100-2-3 (1991): T-72, 25 deg side slope", confidence: low),
        fording_depth_m: (value: 1.2, source: "FM 100-2-3 (1991): T-72, unprepared", confidence: low),
        vertical_step_m: (value: 0.85, source: "FM 100-2-3 (1991): T-72", confidence: low),
        trench_width_m: (value: 2.6, source: "estimate", confidence: estimate, notes: "T-72 running gear."),
        track_ground_contact_m: (value: 4.29, source: "Zaloga, T-72 (Osprey, 1993): T-72 running gear", confidence: low),
        track_width_m: (value: 0.58, source: "Zaloga, T-72 (Osprey, 1993): T-72 running gear", confidence: medium),
        max_yaw_rate_rad_s: (value: 0.5, source: "estimate", confidence: estimate),
        max_lateral_accel_mps2: (value: 3.0, source: "Wong, Theory of Ground Vehicles (5th ed.), skid-steering", confidence: estimate),
        braking_decel_mps2: (value: 4.0, source: "estimate", confidence: estimate),
        fuel_capacity_l: (value: 1200.0, source: "estimate", confidence: estimate, notes: "As the T-72's internal tanks."),
        fuel_idle_lph: (value: 15.0, source: "estimate", confidence: estimate),
        fuel_per_kwh_l: (value: 0.29, source: "estimate", confidence: estimate, notes: "Diesel SFC ~240 g/kWh, density 0.84 kg/L."),
    ),
    gun: (
        depression_rad: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        elevation_rad: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
    ),
    crew: 3,
    sensors: [
        (name: "COMMANDER (CUPOLA/PERISCOPES)", kind: optical, in_service: (from: 1984),
            cycles_per_mrad: (value: 1.5, source: "estimate", confidence: estimate, notes: "Unaided eyes and unity periscopes, as a tank commander.")),
    ],
    fire_control: (
        laser_rangefinder: false,
        laser_range_error_m: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        estimated_range_error_fraction: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        ballistic_error_mrad: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        aim_error_mrad: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        moving_error_mrad: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        lead_error_fraction: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        lay_time_s: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        lase_time_s: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
    ),
    armament: (
        gun: "NONE",
        load: [],
        autoloader: false,
        reload_s: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        turret_traverse_rad_s: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
        max_engagement_range_m: (value: 0.0, source: "estimate", confidence: estimate, notes: "Unused: no weapons."),
    ),
    armour: (
        ce_factor: (value: 1.0, source: "estimate", confidence: estimate),
        turret_front: (value: 40.0, source: "estimate", confidence: estimate, notes: "No turret: the superstructure. Protection against small arms and fragments only."),
        turret_side: (value: 25.0, source: "estimate", confidence: estimate),
        turret_rear: (value: 25.0, source: "estimate", confidence: estimate),
        hull_front: (value: 410.0, source: "open-source estimates for the T-72A hull (range ~380-450 mm vs KE)", confidence: estimate, notes: "The tank's glacis is kept on the recovery vehicle."),
        hull_side: (value: 80.0, source: "estimate: as the T-72A", confidence: estimate),
        hull_rear: (value: 40.0, source: "estimate: as the T-72A", confidence: estimate),
        top: (value: 20.0, source: "estimate", confidence: estimate),
    ),
    ammo_stowage: exposed,
    recovery: (
        tow_speed_mps: (value: 4.5, source: "estimate", confidence: estimate,
            notes: "About 16 km/h with a tank on the rigid tow bar; the same estimate as the Blue type."),
        rated_tow_kg: (value: 50000.0, source: "estimate", confidence: estimate,
            notes: "Built to recover the T-72 family (41-46 t) at full speed; a T-80 or T-72B is within the rating."),
        hookup_s: (value: 300.0, source: "estimate", confidence: estimate, notes: "As the Blue type: about 5 min for a trained crew."),
        unhook_s: (value: 120.0, source: "estimate", confidence: estimate),
    ),
)
