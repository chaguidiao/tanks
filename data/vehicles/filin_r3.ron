// Fictional Red tracked reconnaissance vehicle mirroring the BRM-3K (BMP-3 hull, 1995): 30 mm
// stabilised autocannon, thermal sight, laser rangefinder and a ground-surveillance radar. Open
// sources disagree on its service entry (series production from 1993, adoption 1995, small
// numbers); 1995 is used. The radar is not modelled (the sim has no radar sensor kind).
// One "round" of autocannon ammunition is a burst.
// Values from public sources; most are open-source summaries (confidence low) or estimates.
(
    id: "filin_r3",
    name: "FILIN R3",
    mirrors: "BRM-3K",
    in_service: (from: 1995),
    class: recon,
    dimensions: (
        hull_length_m: (value: 7.14, source: "open-source summaries (Wikipedia, BMP-3, 2026): BMP-3 hull", confidence: low),
        width_m: (value: 3.2, source: "open-source summaries (Wikipedia, BMP-3, 2026): BMP-3 hull", confidence: low),
        height_m: (value: 2.4, source: "open-source summaries (Wikipedia, BMP-3, 2026): BMP-3; the BRM-3K turret is of similar height", confidence: low),
        hull_height_m: (value: 1.7, source: "estimate from published side views", confidence: estimate,
            notes: "BMP-3 hull; the turret adds about 0.7 m."),
        sight_height_m: (value: 2.2, source: "estimate from published side views", confidence: estimate,
            notes: "Sight heads on the turret roof."),
    ),
    mobility: (
        combat_mass_kg: (value: 19600.0, source: "open-source summaries (armedconflicts.com, BRM-3K entry, 2026): 19,600 kg", confidence: low),
        engine_power_w: (value: 368000.0, source: "open-source summaries (armedconflicts.com, BRM-3K entry; Wikipedia, BMP-3, 2026): UTD-29, 368 kW (500 hp)", confidence: low),
        drivetrain_efficiency: (value: 0.70, source: "Ogorkiewicz, Technology of Tanks (1991)", confidence: estimate,
            notes: "Hydromechanical transmission; the same value as the other tracked vehicles here."),
        max_speed_road_mps: (value: 19.4, source: "open-source summaries (Wikipedia, BMP-3, 2026): BMP-3 70-72 km/h", confidence: low,
            notes: "70 km/h, allowing for the heavier reconnaissance fit."),
        max_speed_cross_country_mps: (value: 12.5, source: "open-source summaries (Wikipedia, BMP-3, 2026): BMP-3 45 km/h off road", confidence: low),
        max_speed_reverse_mps: (value: 5.5, source: "estimate", confidence: estimate,
            notes: "Hydromechanical transmission with reverse gears of the BMP-3 class, about 20 km/h."),
        max_slope: (value: 0.60, source: "estimate", confidence: estimate, notes: "Same as the BMP-2 class (data/vehicles/skif_m1.ron)."),
        max_side_slope: (value: 0.47, source: "estimate", confidence: estimate, notes: "25 deg, same as the BMP-2 class."),
        fording_depth_m: (value: 1.5, source: "estimate", confidence: estimate,
            notes: "The vehicle swims (BMP-3 hull, Wikipedia, 2026), but swimming is not modelled; a wading depth is used, as for the BMP-2 class."),
        vertical_step_m: (value: 0.8, source: "estimate", confidence: estimate, notes: "Slightly more than the BMP-2 class (0.7 m) for the larger road wheels."),
        trench_width_m: (value: 2.5, source: "estimate", confidence: estimate, notes: "Same as the BMP-2 class."),
        track_ground_contact_m: (value: 3.6, source: "estimate", confidence: estimate, notes: "Longer hull than the BMP-2 class (3.3 m)."),
        track_width_m: (value: 0.38, source: "estimate", confidence: estimate, notes: "Same as the BMP-2 class."),
        max_yaw_rate_rad_s: (value: 0.9, source: "estimate", confidence: estimate, notes: "Same as the other light tracked hulls."),
        max_lateral_accel_mps2: (value: 3.5, source: "Wong, Theory of Ground Vehicles (5th ed.), skid-steering", confidence: estimate,
            notes: "Same as the other light tracked hulls."),
        braking_decel_mps2: (value: 4.0, source: "estimate", confidence: estimate, notes: "~0.4 g service braking on firm ground."),
        fuel_capacity_l: (value: 690.0, source: "estimate", confidence: estimate, notes: "Open summaries of the BMP-3 hull give about 690 L; not confirmed for the BRM-3K."),
        fuel_idle_lph: (value: 8.0, source: "estimate", confidence: estimate, notes: "Same as the BMP-2 class."),
        fuel_per_kwh_l: (value: 0.29, source: "estimate", confidence: estimate, notes: "Diesel SFC ~240 g/kWh, density 0.84 kg/L."),
    ),
    gun: (
        depression_rad: (value: -0.0873, source: "estimate", confidence: estimate, notes: "-5 deg, as the BMP-2's 30 mm mount."),
        elevation_rad: (value: 1.0472, source: "estimate", confidence: estimate, notes: "+60 deg; a stabilised 30 mm mount for ground and air targets."),
    ),
    crew: 6,
    sensors: [
        (name: "COMMANDER (UNBUTTONED/PERISCOPES)", kind: optical, in_service: (from: 1970),
            cycles_per_mrad: (value: 1.5, source: "estimate", confidence: estimate, notes: "Same as the other vehicles.")),
        (name: "DAY SIGHT 8X", kind: optical, in_service: (from: 1995),
            cycles_per_mrad: (value: 7.0, source: "estimate", confidence: estimate,
                notes: "Reconnaissance optics of about 8x; same resolving power as the tank day sights.")),
        (name: "1PN61-LIKE ACTIVE-PULSE NIGHT SIGHT", kind: night_channel, in_service: (from: 1995),
            cycles_per_mrad: (value: 1.2, source: "estimate", confidence: estimate,
                notes: "Range-gated active-pulse viewer: sharper than a searchlight-lit active IR sight; same value as the image intensifier on falcon_r1."),
            max_range_m: (value: 3000.0, source: "open-source summaries (Wikipedia, BMP-3, 2026): 1PN61 about 3 km", confidence: low)),
        (name: "1PN71-LIKE THERMAL (GEN 1)", kind: thermal, in_service: (from: 1995),
            cycles_per_mrad: (value: 3.0, source: "estimate", confidence: estimate,
                notes: "Thermal sight of 3.7x/11x with about 3 km range (Wikipedia, BMP-3, 2026); a first-generation imager, set equal to falcon_r1's (3.0), below the second-generation sights (5.0)."))
    ],
    fire_control: (
        laser_rangefinder: true,
        laser_range_error_m: (value: 10.0, source: "estimate", confidence: estimate,
            notes: "1D14-class laser rangefinder (armedconflicts.com, BRM-3K entry, 2026); same error as the Red tanks."),
        estimated_range_error_fraction: (value: 0.12, source: "Ogorkiewicz (1991), stadiametric ranging", confidence: estimate,
            notes: "Fallback without the laser, as the other vehicles."),
        ballistic_error_mrad: (value: 0.4, source: "estimate", confidence: estimate, notes: "Ballistic computer; between the BMP-2 class (0.5) and the tanks."),
        aim_error_mrad: (value: 0.25, source: "estimate", confidence: estimate, notes: "Slightly better than the BMP-2 class (0.3) with a stabilised sight."),
        moving_error_mrad: (value: 1.0, source: "estimate", confidence: estimate, notes: "Two-plane stabilised 30 mm; slightly better than the BMP-2 class (1.2)."),
        lead_error_fraction: (value: 0.25, source: "estimate", confidence: estimate, notes: "Lead computed; better than the BMP-2 class (0.3)."),
        lay_time_s: (value: 3.0, source: "estimate", confidence: estimate, notes: "Same as the other light turrets."),
        lase_time_s: (value: 1.5, source: "estimate", confidence: estimate, notes: "Same as the Red tanks."),
    ),
    armament: (
        gun: "30 MM AUTOCANNON",
        load: [(ammo: "he_30", count: 80), (ammo: "apds_30", count: 40)],
        autoloader: true,
        reload_s: (value: 1.8, source: "estimate", confidence: estimate,
            notes: "One burst of about five rounds plus laying (600 rounds carried, Wikipedia, BMP-3, 2026), as the BMP-2 class."),
        turret_traverse_rad_s: (value: 0.6, source: "estimate", confidence: estimate, notes: "Same as the BMP-2 class."),
        max_engagement_range_m: (value: 2000.0, source: "estimate", confidence: estimate, notes: "The 30 mm rounds' own limit."),
    ),
    coax: (name: "7.62 MM COAX (PKT)", count: 1,
        rounds_per_burst: (value: 10.0, source: "FM 3-22.68 (2003): coax bursts of about 10-20 rounds; estimate", confidence: low),
        burst_interval_s: (value: 5.0, source: "FM 3-22.68 (2003): sustained fire about 100 rounds/min", confidence: low),
        max_range_m: (value: 900.0, source: "FM 3-22.68 (2003): 7.62 mm tracer burnout about 900 m", confidence: medium),
        dispersion_mrad: (value: 2.5, source: "estimate", confidence: estimate, notes: "Rigid mount laid through the gunner's sight; beaten zone of the burst dominates."),
        bursts: 200),  // open sources: 2,000 rounds of 7.62 mm; bursts of 10
    armour: (
        ce_factor: (value: 1.0, source: "estimate: aluminium and thin steel have no special CE protection", confidence: estimate),
        turret_front: (value: 45.0, source: "open-source summaries (Wikipedia, BMP-3, 2026): 16 mm steel, 70 mm space, 50 mm aluminium on the BMP-3 turret", confidence: estimate,
            notes: "RHA equivalence of the spaced steel/aluminium front. The same source says the front stops 30 mm rounds at 200 m (likely full-calibre AP); against the 30 mm APDS here (data/ammo/apds_30.ron) it holds beyond about 1.2 km."),
        turret_side: (value: 20.0, source: "estimate", confidence: estimate, notes: "Same as the BMP-2 class."),
        turret_rear: (value: 15.0, source: "estimate", confidence: estimate, notes: "Same as the BMP-2 class."),
        hull_front: (value: 50.0, source: "open-source summaries (Wikipedia, BMP-3, 2026): 22 mm steel plus 60 mm aluminium", confidence: estimate,
            notes: "Steel plus aluminium (about 0.4 as effective per mm) at a steep slope, about 50 mm line of sight; against the 30 mm APDS here it holds beyond about 550 m."),
        hull_side: (value: 18.0, source: "open-source summaries (Wikipedia, BMP-3, 2026): 43 mm aluminium", confidence: estimate,
            notes: "Aluminium counted at about 0.4 of RHA."),
        hull_rear: (value: 18.0, source: "open-source summaries (Wikipedia, BMP-3, 2026): 43 mm aluminium", confidence: estimate,
            notes: "Aluminium counted at about 0.4 of RHA."),
    ),
    ammo_stowage: exposed,
    smoke_launcher: (
        kinds: ["grenade"],
        salvos: 1,
        clouds_per_salvo: 3,
        range_m: (value: 50.0, source: "estimate", confidence: estimate, notes: "902-series launchers, as the BMP-2 class."),
        arc_deg: (value: 60.0, source: "estimate", confidence: estimate, notes: "Same as the BMP-2 class."),
    ),
    engine_smoke: (kinds: ["engine"]),
)
