// Fictional Red MBT mirroring the Russian T-90A (about 2005): heavier reactive armour, second-
// generation thermal sight, gun-launched missile.
// Values transcribed from public sources; verify against the cited edition before tuning.
(
    id: "kurgan_c",
    name: "KURGAN-C",
    mirrors: "T-90A",
    in_service: (from: 2005),
    class: mbt,
    dimensions: (
        hull_length_m: (value: 6.95, source: "Zaloga, T-72 Main Battle Tank 1974-93 (Osprey, 1993)", confidence: medium),
        width_m: (value: 3.59, source: "Zaloga, T-72 (Osprey, 1993)", confidence: medium),
        height_m: (value: 2.23, source: "Zaloga, T-72 (Osprey, 1993)", confidence: medium),
        hull_height_m: (value: 1.4, source: "estimate from published side views", confidence: estimate),
        sight_height_m: (value: 2.0, source: "estimate from published side views", confidence: estimate),
    ),
    mobility: (
        combat_mass_kg: (value: 46500.0, source: "open editions of Jane's Armour and Artillery: T-90A about 46.5 t", confidence: medium),
        engine_power_w: (value: 736000.0, source: "open editions of Jane's Armour and Artillery: V-92S2, 1,000 hp", confidence: medium),
        drivetrain_efficiency: (value: 0.70, source: "Ogorkiewicz, Technology of Tanks (1991)", confidence: estimate,
            notes: "Mechanical planetary gearboxes lose less than hydrokinetic transmissions."),
        max_speed_road_mps: (value: 16.7, source: "Zaloga, T-72 (Osprey, 1993): 60 km/h", confidence: medium),
        max_speed_cross_country_mps: (value: 11.1, source: "FM 100-2-3 (1991): 35-45 km/h cross-country", confidence: medium, notes: "Mid value of the cited range, 40 km/h."),
        max_speed_reverse_mps: (value: 1.35, source: "FM 100-2-3, The Soviet Army: Troops, Organization and Equipment (1991)", confidence: low,
            notes: "Single reverse gear, ~4.9 km/h."),
        max_slope: (value: 0.58, source: "FM 100-2-3 (1991): 30 deg gradient", confidence: medium),
        max_side_slope: (value: 0.47, source: "FM 100-2-3 (1991): 25 deg side slope", confidence: medium),
        fording_depth_m: (value: 1.2, source: "FM 100-2-3 (1991): 1.2 m unprepared, 5 m with snorkel", confidence: medium),
        vertical_step_m: (value: 0.85, source: "FM 100-2-3 (1991)", confidence: medium),
        trench_width_m: (value: 2.8, source: "FM 100-2-3 (1991)", confidence: medium),
        track_ground_contact_m: (value: 4.29, source: "Zaloga, T-72 (Osprey, 1993)", confidence: low),
        track_width_m: (value: 0.58, source: "Zaloga, T-72 (Osprey, 1993)", confidence: medium),
        max_yaw_rate_rad_s: (value: 0.5, source: "estimate", confidence: estimate,
            notes: "Clutch-and-brake planetary steering is slower to pivot than regenerative steering."),
        max_lateral_accel_mps2: (value: 3.0, source: "Wong, Theory of Ground Vehicles (5th ed.), skid-steering", confidence: estimate,
            notes: "Same limit as other skid-steer hulls; soil dominates."),
        braking_decel_mps2: (value: 4.0, source: "estimate", confidence: estimate, notes: "~0.4 g service braking on firm ground."),
        fuel_capacity_l: (value: 1200.0, source: "Zaloga, T-72 (Osprey, 1993): internal tanks, excl. external drums", confidence: medium),
        fuel_idle_lph: (value: 15.0, source: "estimate", confidence: estimate, notes: "Typical large diesel idle consumption."),
        fuel_per_kwh_l: (value: 0.29, source: "estimate", confidence: estimate,
            notes: "Diesel SFC ~240 g/kWh, density 0.84 kg/L."),
    ),
    gun: (
        depression_rad: (value: -0.1047, source: "Zaloga, T-72 (Osprey, 1993): -6 deg", confidence: medium),
        elevation_rad: (value: 0.2443, source: "Zaloga, T-72 (Osprey, 1993): +14 deg", confidence: medium),
    ),
    crew: 3,
    sensors: [
        (name: "COMMANDER (UNBUTTONED/PERISCOPES)", kind: optical, in_service: (from: 1970),
            cycles_per_mrad: (value: 1.5, source: "estimate", confidence: estimate)),
        (name: "DAY SIGHT 8X", kind: optical, in_service: (from: 1992),
            cycles_per_mrad: (value: 7.5, source: "estimate", confidence: estimate, notes: "8x optic.")),
        (name: "GUNNER THERMAL (GEN 2)", kind: thermal, in_service: (from: 2005),
            cycles_per_mrad: (value: 5.0, source: "Vollmerhausen & Jacobs (2004); second-generation imager of a licence-built common-module class", confidence: estimate)),
    ],
    fire_control: (
        laser_rangefinder: true,
        laser_range_error_m: (value: 8.0, source: "estimate", confidence: estimate),
        estimated_range_error_fraction: (value: 0.12, source: "estimate", confidence: estimate),
        ballistic_error_mrad: (value: 0.3, source: "estimate", confidence: estimate, notes: "Simpler ballistic computer."),
        aim_error_mrad: (value: 0.12, source: "estimate", confidence: estimate),
        moving_error_mrad: (value: 0.8, source: "estimate", confidence: estimate, notes: "Gun stabiliser with a less capable sight link."),
        lead_error_fraction: (value: 0.25, source: "estimate", confidence: estimate),
        lay_time_s: (value: 4.0, source: "estimate", confidence: estimate),
        lase_time_s: (value: 1.5, source: "estimate", confidence: estimate),
    ),
    armament: (
        gun: "125 MM SMOOTHBORE",
        load: [(ammo: "apfsds_125c", count: 20), (ammo: "atgm_refleks", count: 4, prefer_beyond_m: (value: 2500.0, source: "estimate (plan M8B-AT-TEAMS §5)", confidence: estimate, notes: "Gun-launched missiles are meant for targets beyond the effective range of the sabot, about 2.5 km.")), (ammo: "hefrag_125", count: 10), (ammo: "heat_125", count: 6)],
        autoloader: true,
        reload_s: (value: 7.1, source: "Zaloga, T-72 (Osprey, 1993): autoloader cycle", confidence: medium),
        turret_traverse_rad_s: (value: 0.42, source: "estimate", confidence: estimate),
        max_engagement_range_m: (value: 3000.0, source: "estimate", confidence: estimate),
    ),
    coax: (name: "7.62 MM COAX (PKT)", count: 1,
        rounds_per_burst: (value: 10.0, source: "FM 3-22.68 (2003): coax bursts of about 10-20 rounds; estimate", confidence: low),
        burst_interval_s: (value: 5.0, source: "FM 3-22.68 (2003): sustained fire about 100 rounds/min", confidence: low),
        max_range_m: (value: 900.0, source: "FM 3-22.68 (2003): 7.62 mm tracer burnout about 900 m", confidence: medium),
        dispersion_mrad: (value: 2.5, source: "estimate", confidence: estimate, notes: "Rigid mount laid through the gunner's sight; beaten zone of the burst dominates."),
        bursts: 200),  // open sources: 2,000 rounds of 7.62 mm for the PKT; bursts of 10
    armour: (
        ce_factor: (value: 1.4, source: "open-source estimates: special-armour insert and glacis laminate give a modest edge against shaped charges", confidence: estimate),
        era: (
            in_service: (from: 1992),
            tiles: 150,
            coverage: (value: 0.8, source: "estimate: tiles cover the glacis, turret front and side skirts, more densely than first-generation fits", confidence: estimate),
            ce_defeat: (value: 0.7, source: "open-source estimates: Kontakt-5 class cuts HEAT penetration by well over half", confidence: low),
            ke_gain_mm: (value: 150.0, source: "open-source estimates: Kontakt-5 class heavy ERA disrupts long-rod penetrators, worth very roughly 150-250 mm RHA against them", confidence: low),
        ),
        turret_front: (value: 600.0, source: "open-source estimates (range ~550-700 mm vs KE, before ERA)", confidence: estimate,
            notes: "Welded turret with a composite insert; the ERA adds to this (see era)."),
        turret_side: (value: 110.0, source: "estimate", confidence: estimate),
        turret_rear: (value: 60.0, source: "estimate", confidence: estimate),
        hull_front: (value: 520.0, source: "open-source estimates (range ~480-560 mm vs KE, before ERA)", confidence: estimate),
        hull_side: (value: 80.0, source: "estimate", confidence: estimate),
        hull_rear: (value: 40.0, source: "estimate", confidence: estimate),
        top: (value: 40.0, source: "estimate (plan M8B-AT-TEAMS §3)", confidence: estimate,
            notes: "No authoritative public figure. A game database gives about 45 mm for a T-72B turret roof and about 20 mm for its engine deck; one value stands for both, nearer the turret, which takes most plunging hits. Every anti-tank warhead in the data defeats it, so results do not depend on it (plan M8B-AT-TEAMS §3)."),
    ),
    ammo_stowage: exposed,
    smoke_launcher: (
        kinds: ["grenade"],
        salvos: 1,
        clouds_per_salvo: 4,
        range_m: (value: 50.0, source: "Zaloga, T-72 (Osprey, 1993): 902B launcher, eight 81 mm tubes on the turret front", confidence: low),
        arc_deg: (value: 70.0, source: "estimate", confidence: estimate, notes: "Tubes fixed in a fan on the turret front; fires one salvo per reload."),
    ),
    engine_smoke: (kinds: ["engine"]),
)
