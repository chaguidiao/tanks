// Fictional Blue infantry fighting vehicle mirroring the M2 Bradley (1981). Dismounts are not
// modelled yet: only the vehicle's own weapons count. One "round" of autocannon ammunition is a
// burst. Values transcribed from public sources; verify against the cited edition before tuning.
(
    id: "ward_m2",
    name: "WARD M2",
    mirrors: "M2 Bradley",
    in_service: (from: 1981),
    class: ifv,
    dimensions: (
        hull_length_m: (value: 6.45, source: "open editions of Jane's Armour and Artillery: M2 length", confidence: medium),
        width_m: (value: 3.20, source: "open editions of Jane's Armour and Artillery: M2 width", confidence: medium),
        height_m: (value: 2.97, source: "open editions of Jane's Armour and Artillery: to the turret roof", confidence: medium),
        hull_height_m: (value: 1.9, source: "estimate from published side views", confidence: estimate),
        sight_height_m: (value: 2.5, source: "estimate from published side views", confidence: estimate),
    ),
    mobility: (
        combat_mass_kg: (value: 22500.0, source: "open editions of Jane's Armour and Artillery: M2 combat weight about 22.5 t", confidence: medium),
        engine_power_w: (value: 373000.0, source: "open editions of Jane's Armour and Artillery: Cummins VTA-903T, 500 hp", confidence: medium),
        drivetrain_efficiency: (value: 0.70, source: "Ogorkiewicz, Technology of Tanks (1991)", confidence: estimate),
        max_speed_road_mps: (value: 18.3, source: "open editions of Jane's Armour and Artillery: 66 km/h", confidence: medium),
        max_speed_cross_country_mps: (value: 11.1, source: "estimate: about 40 km/h cross-country", confidence: estimate),
        max_speed_reverse_mps: (value: 5.0, source: "estimate", confidence: estimate),
        max_slope: (value: 0.60, source: "open editions of Jane's Armour and Artillery: 60 % gradient", confidence: medium),
        max_side_slope: (value: 0.40, source: "open editions of Jane's Armour and Artillery: 40 % side slope", confidence: low),
        fording_depth_m: (value: 1.1, source: "open editions of Jane's Armour and Artillery: unprepared fording; the vehicle also swims with a flotation screen", confidence: low),
        vertical_step_m: (value: 0.91, source: "open editions of Jane's Armour and Artillery: 36 in", confidence: medium),
        trench_width_m: (value: 2.54, source: "open editions of Jane's Armour and Artillery: 8 ft", confidence: medium),
        track_ground_contact_m: (value: 3.6, source: "estimate", confidence: estimate),
        track_width_m: (value: 0.53, source: "estimate", confidence: estimate),
        max_yaw_rate_rad_s: (value: 0.9, source: "estimate", confidence: estimate),
        max_lateral_accel_mps2: (value: 3.5, source: "Wong, Theory of Ground Vehicles (5th ed.), skid-steering", confidence: estimate),
        braking_decel_mps2: (value: 4.0, source: "estimate", confidence: estimate),
        fuel_capacity_l: (value: 662.0, source: "open editions of Jane's Armour and Artillery: 175 US gal", confidence: low),
        fuel_idle_lph: (value: 8.0, source: "estimate", confidence: estimate),
        fuel_per_kwh_l: (value: 0.29, source: "estimate", confidence: estimate, notes: "Diesel SFC ~240 g/kWh, density 0.84 kg/L."),
    ),
    gun: (
        depression_rad: (value: -0.1396, source: "open editions of Jane's Armour and Artillery: -8 deg", confidence: low),
        elevation_rad: (value: 1.0472, source: "open editions of Jane's Armour and Artillery: +60 deg", confidence: low),
    ),
    crew: 3,
    sensors: [
        (name: "COMMANDER (UNBUTTONED/PERISCOPES)", kind: optical, in_service: (from: 1970),
            cycles_per_mrad: (value: 1.5, source: "estimate", confidence: estimate)),
        (name: "GUNNER ISU DAY SIGHT 8X", kind: optical, in_service: (from: 1981),
            cycles_per_mrad: (value: 6.5, source: "estimate", confidence: estimate, notes: "Integrated sight unit, 4x/12x optic; mid value.")),
        (name: "ISU THERMAL (EARLY)", kind: thermal, in_service: (from: 1981),
            cycles_per_mrad: (value: 2.5, source: "estimate", confidence: estimate,
                notes: "Early integrated sight unit with a first-generation imager for TOW; open sources are unclear on its performance, so this is an estimate.")),
        (name: "IBAS THERMAL (GEN 2)", kind: thermal, in_service: (from: 2000),
            cycles_per_mrad: (value: 5.0, source: "Vollmerhausen & Jacobs (2004); second-generation imager of the improved Bradley acquisition upgrade", confidence: estimate)),
    ],
    fire_control: (
        laser_rangefinder: false,
        laser_range_error_m: (value: 20.0, source: "estimate", confidence: estimate, notes: "Unused: no laser rangefinder."),
        estimated_range_error_fraction: (value: 0.12, source: "Ogorkiewicz (1991), stadiametric ranging", confidence: estimate),
        ballistic_error_mrad: (value: 0.4, source: "estimate", confidence: estimate),
        aim_error_mrad: (value: 0.3, source: "estimate", confidence: estimate),
        moving_error_mrad: (value: 1.2, source: "estimate", confidence: estimate, notes: "Stabilised, with a simple sight link."),
        lead_error_fraction: (value: 0.3, source: "estimate", confidence: estimate),
        lay_time_s: (value: 3.0, source: "estimate", confidence: estimate),
        lase_time_s: (value: 1.5, source: "estimate", confidence: estimate),
    ),
    armament: (
        gun: "25 MM AUTOCANNON + TOW",
        load: [(ammo: "atgm_tow2", count: 7, prefer_beyond_m: (value: 2000.0, source: "estimate (plan M8B-AT-TEAMS §5)", confidence: estimate, notes: "Beyond about 2 km the 25 mm gun is ineffective against armour; inside it the gun is used and missiles are kept for tanks.")), (ammo: "atgm_tow", count: 7, prefer_beyond_m: (value: 2000.0, source: "estimate (plan M8B-AT-TEAMS §5)", confidence: estimate, notes: "Beyond about 2 km the 25 mm gun is ineffective against armour; inside it the gun is used and missiles are kept for tanks.")), (ammo: "he_25", count: 120), (ammo: "apds_25", count: 60)],
        autoloader: true,
        reload_s: (value: 1.8, source: "estimate", confidence: estimate, notes: "One burst of about four rounds at the cyclic rate, plus laying."),
        turret_traverse_rad_s: (value: 0.6, source: "estimate", confidence: estimate),
        max_engagement_range_m: (value: 4000.0, source: "estimate", confidence: estimate, notes: "The missile's reach; each round type carries its own limit."),
    ),
    coax: (name: "7.62 MM COAX (M240C)", count: 1,
        rounds_per_burst: (value: 10.0, source: "FM 3-22.68 (2003): coax bursts of about 10-20 rounds; estimate", confidence: low),
        burst_interval_s: (value: 5.0, source: "FM 3-22.68 (2003): sustained fire about 100 rounds/min", confidence: low),
        max_range_m: (value: 900.0, source: "FM 3-22.68 (2003): 7.62 mm tracer burnout about 900 m", confidence: medium),
        dispersion_mrad: (value: 2.5, source: "estimate", confidence: estimate, notes: "Rigid mount laid through the gunner's sight; beaten zone of the burst dominates."),
        bursts: 220),  // Hunnicutt, Bradley (1999): 2,200 rounds of 7.62 mm; bursts of 10
    troops: (capacity_men: 6,
        dismount_s: (value: 20.0, source: "Hunnicutt, Bradley (1999): power ramp; estimate", confidence: estimate, notes: "Halt, open, squad out and into its security posture."),
        mount_s: (value: 30.0, source: "Hunnicutt, Bradley (1999): power ramp; estimate", confidence: estimate, notes: "Squad in from its security posture, doors closed.")),  // FM 7-7J (1986): six dismounts in the M2
    armour: (
        ce_factor: (value: 1.0, source: "estimate: aluminium armour has no special CE protection", confidence: estimate),
        turret_front: (value: 38.0, source: "open-source estimates: welded aluminium turret (the M2A0 has no applique armour)", confidence: low),
        turret_side: (value: 25.0, source: "estimate", confidence: estimate),
        turret_rear: (value: 20.0, source: "estimate", confidence: estimate),
        hull_front: (value: 40.0, source: "open-source estimates: sloped aluminium glacis, steel-equivalent", confidence: low),
        hull_side: (value: 25.0, source: "estimate", confidence: estimate),
        hull_rear: (value: 20.0, source: "estimate", confidence: estimate),
        top: (value: 15.0, source: "estimate (plan M8B-AT-TEAMS §3)", confidence: estimate,
            notes: "Aluminium-alloy roof, about a third as effective as steel per millimetre; no authoritative public figure. Only autocannon and HE fragments are sensitive to it."),
    ),
    ammo_stowage: exposed,
    smoke_launcher: (
        kinds: ["grenade"],
        salvos: 1,
        clouds_per_salvo: 3,
        range_m: (value: 30.0, source: "estimate: two banks of four grenade launchers on the turret", confidence: estimate),
        arc_deg: (value: 60.0, source: "estimate", confidence: estimate),
    ),
)
