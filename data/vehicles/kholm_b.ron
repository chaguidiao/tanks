// Fictional Red MBT mirroring the Soviet T-64B (1976; T-64BV with reactive armour from 1985):
// 125 mm gun that also fires a radio-command missile, laser rangefinder sight with a ballistic
// computer, no thermal sight. Withdrawn from the Red side's active units by 1995 (the Russian
// army put its T-64s in storage in the early 1990s), so it appears in Cold War years only.
// Values from public sources; most are open-source summaries (confidence low) or estimates.
// Sabot: the 3BM22-class round before 1986 and the 3BM42-class round after. Both are in the load;
// from 1986 both are stocked (as the 1985-89 sabot overlap of bulwark_a1), so a late-1980s tank
// carries a few more sabot and fewer HE-FRAG than the real racks would hold.
(
    id: "kholm_b",
    name: "KHOLM-B",
    mirrors: "T-64B/BV",
    in_service: (from: 1976, to: 1995),
    class: mbt,
    dimensions: (
        hull_length_m: (value: 6.54, source: "open-source summaries (Wikipedia, T-64, 2026): T-64BV 6.54 m without the gun", confidence: low),
        width_m: (value: 3.42, source: "open-source summaries (Wikipedia, T-64, 2026): 3.415 m", confidence: low),
        height_m: (value: 2.17, source: "open-source summaries (Wikipedia, T-64, 2026): 2.17-2.172 m", confidence: medium),
        hull_height_m: (value: 1.4, source: "estimate from published side views", confidence: estimate,
            notes: "Low hull of the same height class as the T-72."),
        sight_height_m: (value: 2.0, source: "estimate from published side views", confidence: estimate,
            notes: "Gunner's sight head on the turret roof, as on the T-72."),
    ),
    mobility: (
        combat_mass_kg: (value: 42400.0, source: "open-source summaries (Wikipedia, T-64, 2026): T-64BV 42.5 t; the B without tiles slightly less", confidence: low),
        engine_power_w: (value: 515000.0, source: "open-source summaries (Wikipedia, T-64, 2026): 5TDF two-stroke diesel, 700 hp", confidence: medium),
        drivetrain_efficiency: (value: 0.70, source: "Ogorkiewicz, Technology of Tanks (1991)", confidence: estimate,
            notes: "Mechanical planetary gearboxes lose less than hydrokinetic transmissions."),
        max_speed_road_mps: (value: 16.8, source: "open-source summaries (Wikipedia, T-64, 2026): T-64BV 60.5 km/h", confidence: low),
        max_speed_cross_country_mps: (value: 9.7, source: "open-source summaries (Wikipedia, T-64, 2026): T-64BV 35 km/h off road", confidence: low),
        max_speed_reverse_mps: (value: 1.2, source: "estimate", confidence: estimate,
            notes: "Single low reverse gear like the T-72's (data/vehicles/kurgan_a.ron); open sources give no figure."),
        max_slope: (value: 0.58, source: "open-source summaries (Wikipedia, T-64, 2026): 30 deg gradient", confidence: low),
        max_side_slope: (value: 0.47, source: "estimate", confidence: estimate, notes: "25 deg, the FM 100-2-3 figure for Soviet MBTs of the period."),
        fording_depth_m: (value: 1.8, source: "open-source summaries (Wikipedia, T-64, 2026): about 1.8 m unprepared, 5 m with snorkel", confidence: low),
        vertical_step_m: (value: 0.8, source: "open-source summaries (Wikipedia, T-64, 2026)", confidence: low),
        trench_width_m: (value: 2.8, source: "open-source summaries (Wikipedia, T-64, 2026)", confidence: low),
        track_ground_contact_m: (value: 4.35, source: "estimate", confidence: estimate,
            notes: "From the published ground pressure (0.9 kgf/cm2 at 42.5 t) and the track width: 42,500 / (2 x 0.9 x 54) cm."),
        track_width_m: (value: 0.54, source: "estimate", confidence: estimate, notes: "Narrower than the T-72's 580 mm track, from published views."),
        max_yaw_rate_rad_s: (value: 0.5, source: "estimate", confidence: estimate,
            notes: "Planetary steering with two side gearboxes; same as the T-72 here."),
        max_lateral_accel_mps2: (value: 3.0, source: "Wong, Theory of Ground Vehicles (5th ed.), skid-steering", confidence: estimate,
            notes: "Same limit as other skid-steer hulls; soil dominates."),
        braking_decel_mps2: (value: 4.0, source: "estimate", confidence: estimate, notes: "~0.4 g service braking on firm ground."),
        fuel_capacity_l: (value: 1000.0, source: "estimate", confidence: estimate,
            notes: "Open summaries disagree (740-1,100 L internal, plus external drums); a mid value."),
        fuel_idle_lph: (value: 15.0, source: "estimate", confidence: estimate, notes: "Typical large diesel idle consumption."),
        fuel_per_kwh_l: (value: 0.31, source: "estimate", confidence: estimate,
            notes: "Two-stroke diesel, SFC ~255 g/kWh, density 0.84 kg/L."),
    ),
    gun: (
        depression_rad: (value: -0.0931, source: "open-source summaries (Wikipedia, T-64, 2026): stabiliser limits -5 deg 20 min", confidence: low),
        elevation_rad: (value: 0.2662, source: "open-source summaries (Wikipedia, T-64, 2026): stabiliser limits +15 deg 15 min", confidence: low),
    ),
    crew: 3,
    sensors: [
        (name: "COMMANDER (UNBUTTONED/PERISCOPES)", kind: optical, in_service: (from: 1970),
            cycles_per_mrad: (value: 1.5, source: "estimate", confidence: estimate, notes: "Same as the other Red tanks.")),
        (name: "1G21-LIKE DAY SIGHT 8X", kind: optical, in_service: (from: 1976),
            cycles_per_mrad: (value: 7.0, source: "estimate", confidence: estimate,
                notes: "Laser rangefinder sight with about 8x magnification; same resolving power as the T-72's.")),
        (name: "ACTIVE IR NIGHT SIGHT", kind: night_channel, in_service: (from: 1970),
            cycles_per_mrad: (value: 0.6, source: "estimate", confidence: estimate, notes: "TPN-1-49-23 class, as on the T-72."),
            max_range_m: (value: 800.0, source: "FM 100-2-3 (1991): active IR night sights ~800-1000 m", confidence: low)),
    ],
    fire_control: (
        laser_rangefinder: true,
        laser_range_error_m: (value: 10.0, source: "estimate", confidence: estimate, notes: "Same ruby/Nd laser class as the T-72's."),
        estimated_range_error_fraction: (value: 0.12, source: "estimate", confidence: estimate, notes: "Stadiametric fallback, as the T-72."),
        ballistic_error_mrad: (value: 0.25, source: "estimate", confidence: estimate,
            notes: "1A33 system with a ballistic computer and cross-wind sensor (Wikipedia, T-64, 2026); a little better than the T-72A's simpler system (0.3)."),
        aim_error_mrad: (value: 0.15, source: "estimate", confidence: estimate, notes: "Same as the T-72."),
        moving_error_mrad: (value: 0.7, source: "estimate", confidence: estimate,
            notes: "Two-plane stabiliser linked to a stabilised sight; slightly better than the T-72A (0.8)."),
        lead_error_fraction: (value: 0.2, source: "estimate", confidence: estimate, notes: "Lead computed by the 1A33's computer."),
        lay_time_s: (value: 4.0, source: "estimate", confidence: estimate, notes: "Same as the T-72."),
        lase_time_s: (value: 1.5, source: "estimate", confidence: estimate, notes: "Same as the T-72."),
    ),
    armament: (
        gun: "125 MM SMOOTHBORE + ATGM",
        load: [(ammo: "apfsds_125b", count: 10), (ammo: "apfsds_125a", count: 10), (ammo: "atgm_kobra", count: 6), (ammo: "hefrag_125", count: 10), (ammo: "heat_125", count: 6)],
        autoloader: true,
        reload_s: (value: 7.1, source: "open-source summaries (Wikipedia, T-80, 2026): carousel loader 7.1 s for the nearest round", confidence: low,
            notes: "Same carousel family as the T-80; a far round takes longer, a sequence of one type less."),
        turret_traverse_rad_s: (value: 0.33, source: "estimate", confidence: estimate,
            notes: "Electro-hydraulic drive of about 18-20 deg/s, a little slower than the value used for the T-72."),
        max_engagement_range_m: (value: 4000.0, source: "estimate", confidence: estimate, notes: "The missile's reach; each round type carries its own limit."),
    ),
    coax: (name: "7.62 MM COAX (PKT)", count: 1,
        rounds_per_burst: (value: 10.0, source: "FM 3-22.68 (2003): coax bursts of about 10-20 rounds; estimate", confidence: low),
        burst_interval_s: (value: 5.0, source: "FM 3-22.68 (2003): sustained fire about 100 rounds/min", confidence: low),
        max_range_m: (value: 900.0, source: "FM 3-22.68 (2003): 7.62 mm tracer burnout about 900 m", confidence: medium),
        dispersion_mrad: (value: 2.5, source: "estimate", confidence: estimate, notes: "Rigid mount laid through the gunner's sight; beaten zone of the burst dominates."),
        bursts: 125),  // Zaloga, T-64 (Osprey): 1,250 rounds of 7.62 mm; bursts of 10
    armour: (
        ce_factor: (value: 1.3, source: "open-source summaries (Wikipedia, T-64, 2026): 370-440 mm vs KE and 500-575 mm vs HEAT for the series", confidence: estimate,
            notes: "Ratio of the CE to the KE ranges; steel and glass-fibre laminate favours CE protection."),
        era: (
            in_service: (from: 1985),
            tiles: 90,
            coverage: (value: 0.7, source: "estimate: tiles cover the glacis, turret front and side skirts but not every spot", confidence: estimate,
                notes: "Same first-generation fit as kurgan_b."),
            ce_defeat: (value: 0.6, source: "open-source estimates: first-generation ERA (Kontakt-1 class) cuts HEAT penetration by roughly half to two thirds", confidence: low),
            ke_gain_mm: (value: 15.0, source: "open-source estimates: first-generation ERA adds little against long-rod penetrators", confidence: low),
        ),
        turret_front: (value: 430.0, source: "open-source summaries (Wikipedia, T-64, 2026): 370-440 mm vs KE for the series", confidence: estimate,
            notes: "Upper part of the series range for the B; cast turret with a steel/glass-fibre insert."),
        turret_side: (value: 110.0, source: "estimate", confidence: estimate, notes: "Same as the T-72."),
        turret_rear: (value: 60.0, source: "estimate", confidence: estimate, notes: "Same as the T-72."),
        hull_front: (value: 410.0, source: "open-source summaries (Wikipedia, T-64, 2026): 120 mm steel, 105 mm glass fibre, 40 mm steel glacis at a steep angle", confidence: estimate,
            notes: "Line-of-sight equivalence of the laminate glacis, set equal to the T-72A's."),
        hull_side: (value: 80.0, source: "estimate", confidence: estimate, notes: "Same as the T-72."),
        hull_rear: (value: 40.0, source: "estimate", confidence: estimate, notes: "Same as the T-72."),
    ),
    ammo_stowage: exposed,
    smoke_launcher: (
        kinds: ["grenade"],
        salvos: 1,
        clouds_per_salvo: 4,
        range_m: (value: 50.0, source: "estimate", confidence: estimate, notes: "902-series 81 mm launchers on the turret, as on the T-72."),
        arc_deg: (value: 70.0, source: "estimate", confidence: estimate, notes: "Tubes fixed in a fan on the turret front; fires one salvo per reload."),
    ),
    engine_smoke: (kinds: ["engine"]),
)
