// Fictional Blue light reconnaissance vehicle mirroring the FV107 Scimitar (1971).
// Values transcribed from public sources; verify against the cited edition before tuning.
(
    id: "falcon_r1",
    name: "FALCON R1",
    mirrors: "FV107 Scimitar",
    in_service: (from: 1975),
    class: recon,
    dimensions: (
        hull_length_m: (value: 4.9, source: "Jane's Armour and Artillery (open editions): CVR(T) family", confidence: low),
        width_m: (value: 2.2, source: "Jane's Armour and Artillery (open editions)", confidence: low),
        height_m: (value: 2.1, source: "Jane's Armour and Artillery (open editions)", confidence: low),
        hull_height_m: (value: 1.3, source: "estimate from published side views", confidence: estimate),
        sight_height_m: (value: 1.8, source: "estimate from published side views", confidence: estimate),
    ),
    mobility: (
        combat_mass_kg: (value: 7800.0, source: "Jane's Armour and Artillery (open editions)", confidence: low),
        engine_power_w: (value: 140000.0, source: "Jane's Armour and Artillery (open editions): Jaguar petrol engine, ~190 hp", confidence: low),
        drivetrain_efficiency: (value: 0.75, source: "Ogorkiewicz, Technology of Tanks (1991)", confidence: estimate),
        max_speed_road_mps: (value: 22.0, source: "Jane's Armour and Artillery (open editions): ~80 km/h", confidence: low),
        max_speed_cross_country_mps: (value: 14.0, source: "estimate", confidence: estimate),
        max_speed_reverse_mps: (value: 10.0, source: "estimate", confidence: estimate),
        max_slope: (value: 0.60, source: "Jane's Armour and Artillery (open editions)", confidence: low),
        max_side_slope: (value: 0.40, source: "Jane's Armour and Artillery (open editions)", confidence: low),
        fording_depth_m: (value: 1.0, source: "Jane's Armour and Artillery (open editions)", confidence: low),
        vertical_step_m: (value: 0.5, source: "Jane's Armour and Artillery (open editions)", confidence: low),
        trench_width_m: (value: 2.0, source: "Jane's Armour and Artillery (open editions)", confidence: low),
        track_ground_contact_m: (value: 2.9, source: "estimate", confidence: estimate),
        track_width_m: (value: 0.43, source: "estimate", confidence: estimate),
        max_yaw_rate_rad_s: (value: 1.0, source: "estimate", confidence: estimate),
        max_lateral_accel_mps2: (value: 3.5, source: "Wong, Theory of Ground Vehicles (5th ed.), skid-steering", confidence: estimate),
        braking_decel_mps2: (value: 4.5, source: "estimate", confidence: estimate),
        fuel_capacity_l: (value: 410.0, source: "Jane's Armour and Artillery (open editions)", confidence: low),
        fuel_idle_lph: (value: 6.0, source: "estimate", confidence: estimate),
        fuel_per_kwh_l: (value: 0.40, source: "estimate", confidence: estimate, notes: "Petrol SFC ~300 g/kWh, density 0.74 kg/L."),
    ),
    gun: (
        depression_rad: (value: -0.1396, source: "Jane's Armour and Artillery (open editions): -8 deg", confidence: low),
        elevation_rad: (value: 0.6109, source: "Jane's Armour and Artillery (open editions): +35 deg", confidence: low),
    ),
    crew: 3,
    sensors: [
        (name: "COMMANDER (UNBUTTONED/PERISCOPES)", kind: optical, in_service: (from: 1970),
            cycles_per_mrad: (value: 1.5, source: "estimate", confidence: estimate)),
        (name: "GUNNER DAY SIGHT 6X", kind: optical, in_service: (from: 1975),
            cycles_per_mrad: (value: 5.5, source: "estimate", confidence: estimate, notes: "6x optic.")),
        (name: "IMAGE INTENSIFIER NIGHT SIGHT", kind: night_channel, in_service: (from: 1980),
            cycles_per_mrad: (value: 1.2, source: "estimate", confidence: estimate),
            max_range_m: (value: 1200.0, source: "estimate", confidence: estimate)),
        (name: "THERMAL IMAGER", kind: thermal, in_service: (from: 1988),
            cycles_per_mrad: (value: 3.0, source: "estimate", confidence: estimate, notes: "First-generation imager with a small aperture.")),
    ],
    fire_control: (
        laser_rangefinder: false,
        laser_range_error_m: (value: 20.0, source: "estimate", confidence: estimate, notes: "Unused: no laser rangefinder."),
        estimated_range_error_fraction: (value: 0.1, source: "Ogorkiewicz (1991), stadiametric ranging", confidence: estimate),
        ballistic_error_mrad: (value: 0.5, source: "estimate", confidence: estimate),
        aim_error_mrad: (value: 0.3, source: "estimate", confidence: estimate),
        moving_error_mrad: (value: 1.5, source: "estimate", confidence: estimate, notes: "Light vehicle, no gun stabilisation."),
        lead_error_fraction: (value: 0.3, source: "estimate", confidence: estimate),
        lay_time_s: (value: 3.0, source: "estimate", confidence: estimate),
        lase_time_s: (value: 1.5, source: "estimate", confidence: estimate),
    ),
    armament: (
        gun: "30 MM AUTOCANNON",
        load: [(ammo: "he_30", count: 60), (ammo: "apds_30", count: 30)],
        autoloader: true,
        reload_s: (value: 2.0, source: "estimate", confidence: estimate, notes: "One burst plus laying."),
        turret_traverse_rad_s: (value: 0.7, source: "estimate", confidence: estimate),
        max_engagement_range_m: (value: 2000.0, source: "estimate", confidence: estimate),
    ),
    coax: (name: "7.62 MM COAX (GPMG)", count: 1,
        rounds_per_burst: (value: 10.0, source: "FM 3-22.68 (2003): coax bursts of about 10-20 rounds; estimate", confidence: low),
        burst_interval_s: (value: 5.0, source: "FM 3-22.68 (2003): sustained fire about 100 rounds/min", confidence: low),
        max_range_m: (value: 900.0, source: "FM 3-22.68 (2003): 7.62 mm tracer burnout about 900 m", confidence: medium),
        dispersion_mrad: (value: 2.0, source: "estimate", confidence: estimate, notes: "Rigid mount laid through the gunner's sight; beaten zone of the burst dominates."),
        bursts: 300),  // open sources: about 3,000 rounds of 7.62 mm in the Scimitar; bursts of 10
    armour: (
        ce_factor: (value: 1.0, source: "estimate: aluminium armour has no special CE protection", confidence: estimate),
        turret_front: (value: 12.0, source: "open-source estimates (aluminium, proof against small arms)", confidence: low),
        turret_side: (value: 12.0, source: "estimate", confidence: estimate),
        turret_rear: (value: 10.0, source: "estimate", confidence: estimate),
        hull_front: (value: 14.0, source: "estimate", confidence: estimate),
        hull_side: (value: 12.0, source: "estimate", confidence: estimate),
        hull_rear: (value: 10.0, source: "estimate", confidence: estimate),
    ),
    ammo_stowage: isolated,
    smoke_launcher: (
        kinds: ["grenade"],
        salvos: 1,
        clouds_per_salvo: 3,
        range_m: (value: 30.0, source: "estimate", confidence: estimate),
        arc_deg: (value: 70.0, source: "estimate", confidence: estimate),
    ),
)
