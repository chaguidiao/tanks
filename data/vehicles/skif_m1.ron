// Fictional Red infantry fighting vehicle mirroring the BMP-2 (1980). Dismounts are not modelled
// yet: only the vehicle's own weapons count. One "round" of autocannon ammunition is a burst.
// Values transcribed from public sources; verify against the cited edition before tuning.
(
    id: "skif_m1",
    name: "SKIF M1",
    mirrors: "BMP-2",
    in_service: (from: 1980),
    class: ifv,
    dimensions: (
        hull_length_m: (value: 6.72, source: "Zaloga, BMP-1/BMP-2 Infantry Fighting Vehicle 1966-94 (Osprey, 1995)", confidence: medium),
        width_m: (value: 3.15, source: "Zaloga, BMP (Osprey, 1995)", confidence: medium),
        height_m: (value: 2.45, source: "Zaloga, BMP (Osprey, 1995): to the turret roof", confidence: medium),
        hull_height_m: (value: 1.6, source: "estimate from published side views", confidence: estimate),
        sight_height_m: (value: 2.1, source: "estimate from published side views", confidence: estimate),
    ),
    mobility: (
        combat_mass_kg: (value: 14300.0, source: "Zaloga, BMP (Osprey, 1995)", confidence: medium),
        engine_power_w: (value: 220000.0, source: "Zaloga, BMP (Osprey, 1995): UTD-20, 300 hp", confidence: medium),
        drivetrain_efficiency: (value: 0.70, source: "Ogorkiewicz, Technology of Tanks (1991)", confidence: estimate),
        max_speed_road_mps: (value: 18.0, source: "Zaloga, BMP (Osprey, 1995): 65 km/h", confidence: medium),
        max_speed_cross_country_mps: (value: 12.5, source: "FM 100-2-3 (1991): 45 km/h cross-country", confidence: low),
        max_speed_reverse_mps: (value: 5.0, source: "estimate", confidence: estimate),
        max_slope: (value: 0.60, source: "FM 100-2-3 (1991): 35 deg gradient is claimed; 31 deg used", confidence: low),
        max_side_slope: (value: 0.47, source: "FM 100-2-3 (1991): 25 deg side slope", confidence: low),
        fording_depth_m: (value: 1.5, source: "estimate: the vehicle swims, but depth of wading is used here", confidence: estimate),
        vertical_step_m: (value: 0.7, source: "FM 100-2-3 (1991)", confidence: low),
        trench_width_m: (value: 2.5, source: "FM 100-2-3 (1991)", confidence: low),
        track_ground_contact_m: (value: 3.3, source: "estimate", confidence: estimate),
        track_width_m: (value: 0.38, source: "estimate", confidence: estimate),
        max_yaw_rate_rad_s: (value: 0.9, source: "estimate", confidence: estimate),
        max_lateral_accel_mps2: (value: 3.5, source: "Wong, Theory of Ground Vehicles (5th ed.), skid-steering", confidence: estimate),
        braking_decel_mps2: (value: 4.0, source: "estimate", confidence: estimate),
        fuel_capacity_l: (value: 460.0, source: "Zaloga, BMP (Osprey, 1995)", confidence: low),
        fuel_idle_lph: (value: 8.0, source: "estimate", confidence: estimate),
        fuel_per_kwh_l: (value: 0.29, source: "estimate", confidence: estimate, notes: "Diesel SFC ~240 g/kWh, density 0.84 kg/L."),
    ),
    gun: (
        depression_rad: (value: -0.0873, source: "Zaloga, BMP (Osprey, 1995): -5 deg", confidence: low),
        elevation_rad: (value: 1.2915, source: "Zaloga, BMP (Osprey, 1995): +74 deg", confidence: low),
    ),
    crew: 3,
    sensors: [
        (name: "COMMANDER (UNBUTTONED/PERISCOPES)", kind: optical, in_service: (from: 1970),
            cycles_per_mrad: (value: 1.5, source: "estimate", confidence: estimate)),
        (name: "GUNNER DAY SIGHT 6X", kind: optical, in_service: (from: 1980),
            field_of_view_deg: (value: 10.0, source: "estimate", confidence: estimate, notes: "Military sight eyepieces show about 60 deg apparent field; true field about 60 deg / magnification."),
            cycles_per_mrad: (value: 5.5, source: "estimate", confidence: estimate, notes: "6x optic.")),
        (name: "ACTIVE IR NIGHT SIGHT", kind: night_channel, in_service: (from: 1980),
            field_of_view_deg: (value: 6.0, source: "estimate", confidence: estimate, notes: "Active IR sight: the field lit by the illuminator, about the sight's own field."),
            cycles_per_mrad: (value: 0.6, source: "estimate", confidence: estimate),
            max_range_m: (value: 700.0, source: "FM 100-2-3 (1991): active IR night sights", confidence: low)),
    ],
    fire_control: (
        laser_rangefinder: false,
        laser_range_error_m: (value: 20.0, source: "estimate", confidence: estimate, notes: "Unused: no laser rangefinder."),
        estimated_range_error_fraction: (value: 0.12, source: "Ogorkiewicz (1991), stadiametric ranging", confidence: estimate),
        ballistic_error_mrad: (value: 0.5, source: "estimate", confidence: estimate),
        aim_error_mrad: (value: 0.3, source: "estimate", confidence: estimate),
        moving_error_mrad: (value: 1.2, source: "estimate", confidence: estimate, notes: "Stabilised, with a simple sight link."),
        lead_error_fraction: (value: 0.3, source: "estimate", confidence: estimate),
        lay_time_s: (value: 3.0, source: "estimate", confidence: estimate),
        lase_time_s: (value: 1.5, source: "estimate", confidence: estimate),
    ),
    armament: (
        gun: "30 MM AUTOCANNON + ATGM",
        load: [(ammo: "atgm_sk5", count: 4, prefer_beyond_m: (value: 2000.0, source: "estimate (plan M8B-AT-TEAMS §5)", confidence: estimate, notes: "Beyond about 2 km the 30 mm gun is ineffective against armour; inside it the gun is used and missiles are kept for tanks.")), (ammo: "he_30", count: 60), (ammo: "apds_30", count: 40)],
        autoloader: true,
        reload_s: (value: 1.8, source: "estimate", confidence: estimate, notes: "One burst of about four rounds at the cyclic rate, plus laying."),
        turret_traverse_rad_s: (value: 0.6, source: "estimate", confidence: estimate),
        max_engagement_range_m: (value: 4000.0, source: "estimate", confidence: estimate, notes: "The missile's reach; each round type carries its own limit."),
    ),
    coax: (name: "7.62 MM COAX (PKT)", count: 1,
        rounds_per_burst: (value: 10.0, source: "FM 3-22.68 (2003): coax bursts of about 10-20 rounds; estimate", confidence: low),
        burst_interval_s: (value: 5.0, source: "FM 3-22.68 (2003): sustained fire about 100 rounds/min", confidence: low),
        max_range_m: (value: 900.0, source: "FM 3-22.68 (2003): 7.62 mm tracer burnout about 900 m", confidence: medium),
        dispersion_mrad: (value: 2.5, source: "estimate", confidence: estimate, notes: "Rigid mount laid through the gunner's sight; beaten zone of the burst dominates."),
        bursts: 200),  // Zaloga, BMP (Osprey, 1995): 2,000 rounds of 7.62 mm; bursts of 10
    troops: (capacity_men: 7,
        dismount_s: (value: 20.0, source: "Zaloga, BMP (Osprey, 1995): two rear doors; estimate", confidence: estimate, notes: "Halt, open, squad out and into its security posture."),
        mount_s: (value: 30.0, source: "Zaloga, BMP (Osprey, 1995): two rear doors; estimate", confidence: estimate, notes: "Squad in from its security posture, doors closed.")),  // Zaloga, BMP (Osprey, 1995): seven dismounts in the BMP-2
    armour: (
        ce_factor: (value: 1.0, source: "estimate: thin steel and aluminium armour has no special CE protection", confidence: estimate),
        turret_front: (value: 30.0, source: "open-source estimates (~23-33 mm)", confidence: low),
        turret_side: (value: 20.0, source: "estimate", confidence: estimate),
        turret_rear: (value: 15.0, source: "estimate", confidence: estimate),
        hull_front: (value: 33.0, source: "open-source estimates (~19-33 mm sloped glacis)", confidence: low),
        hull_side: (value: 16.0, source: "estimate", confidence: estimate),
        hull_rear: (value: 16.0, source: "estimate", confidence: estimate),
        top: (value: 10.0, source: "estimate (plan M8B-AT-TEAMS §3)", confidence: estimate,
            notes: "Thin steel roof of a few millimetres to about 10 mm; no authoritative public figure. Only autocannon and HE fragments are sensitive to it."),
    ),
    ammo_stowage: exposed,
    smoke_launcher: (
        kinds: ["grenade"],
        salvos: 1,
        clouds_per_salvo: 3,
        range_m: (value: 50.0, source: "estimate", confidence: estimate),
        arc_deg: (value: 60.0, source: "estimate", confidence: estimate),
    ),
    engine_smoke: (kinds: ["engine"]),
)
