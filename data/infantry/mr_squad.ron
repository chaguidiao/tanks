// Red motorised rifle squad as carried by one BMP (plan M8B-INFANTRY §1). The squad leader,
// driver and gunner of a BMP squad stay with the vehicle or lead it; about seven men dismount
// (FM 100-2-3 (1991) gives eight seats in the BMP-1 and seven in the BMP-2). One PK machine gun
// and one RPK light machine gun per squad; one man carries the RPG-7 (anti_armour, M8b-b).
(
    id: "mr_squad",
    name: "MR SQUAD",
    mirrors: "Soviet BMP motorised rifle squad, dismounted element (FM 100-2-3, 1991)",
    in_service: (from: 1966),
    men: 7,
    weapons: [
        (name: "ASSAULT RIFLES", count: 4,
            rounds_per_burst: (value: 3.0, source: "FM 100-2-3 (1991); estimate as for Blue rifles", confidence: low),
            burst_interval_s: (value: 10.0, source: "estimate as for Blue rifles", confidence: estimate),
            max_range_m: (value: 500.0, source: "FM 100-2-3 (1991): AK-74/AKM effective range about 500 m", confidence: low),
            dispersion_mrad: (value: 6.0, source: "Hitchman, ORO-T-160 (1952) x Rowland (JORS 1987, 1991), as for Blue rifles", confidence: low, notes: "Same combat aiming error as Blue rifles."),
            bursts: 70),
        (name: "LIGHT MG (RPK)", count: 1,
            rounds_per_burst: (value: 4.0, source: "estimate", confidence: estimate, notes: "Magazine-fed: short bursts."),
            burst_interval_s: (value: 6.0, source: "estimate", confidence: estimate),
            max_range_m: (value: 800.0, source: "FM 100-2-3 (1991): RPK about 800 m", confidence: low),
            dispersion_mrad: (value: 5.0, source: "estimate", confidence: estimate),
            bursts: 110),
        (name: "7.62 MM MG (PK)", count: 1,
            rounds_per_burst: (value: 8.0, source: "estimate as for the M60", confidence: estimate),
            burst_interval_s: (value: 5.0, source: "estimate as for the M60", confidence: estimate),
            max_range_m: (value: 1000.0, source: "FM 100-2-3 (1991): PK/PKM about 1000 m", confidence: low),
            dispersion_mrad: (value: 5.0, source: "estimate", confidence: estimate),
            bursts: 90),
    ],
    sensors: [
        (name: "EYES", kind: optical, in_service: (from: 1900),
            cycles_per_mrad: (value: 1.7, source: "estimate: visual acuity of about 1 arcminute per detail", confidence: estimate)),
        (name: "BINOCULARS", kind: optical, in_service: (from: 1900),
            field_of_view_deg: (value: 8.5, source: "open-source summaries (6x30 and 7x50 military binoculars, 2026): 7-8.5 deg", confidence: low),
            cycles_per_mrad: (value: 4.0, source: "estimate", confidence: estimate, notes: "6x-8x glasses used by the squad leader part of the time.")),
        (name: "NIGHT WEAPON SIGHT", kind: night_channel, in_service: (from: 1965, to: 1974),
            field_of_view_deg: (value: 6.0, source: "estimate", confidence: estimate, notes: "Early Soviet weapon night sight (NSP-2 class), narrow field."),
            cycles_per_mrad: (value: 0.5, source: "estimate", confidence: estimate),
            max_range_m: (value: 300.0, source: "FM 100-2-3 (1991): NSP-3 / NSPU class weapon night sights", confidence: low)),
        (name: "NIGHT WEAPON SIGHT (1PN58 CLASS)", kind: night_channel, in_service: (from: 1975),
            field_of_view_deg: (value: 5.0, source: "estimate", confidence: estimate, notes: "Passive weapon sight (NSPU class), about 5 deg."),
            cycles_per_mrad: (value: 0.7, source: "estimate (calibration notes §3)", confidence: low,
                notes: "1PN58 (early 1970s): detection 970 m, recognition 400 m under starlight (target type not given). 1975 is an estimate for issue."),
            max_range_m: (value: 400.0, source: "1PN58 recognition range under starlight (Wikipedia, 1PN58)", confidence: low)),
    ],
    signature: (
        moving: (
            width_m: (value: 1.5, source: "plan M8B-INFANTRY §3; estimate", confidence: estimate, notes: "A group of two or three men in view at once."),
            height_m: (value: 1.8, source: "estimate", confidence: estimate),
            man_area_m2: (value: 0.5, source: "estimate", confidence: estimate, notes: "Crouched rushes rather than a 0.75 m2 standing man."),
            eye_height_m: (value: 1.6, source: "estimate", confidence: estimate)),
        halted: (
            width_m: (value: 1.0, source: "estimate", confidence: estimate, notes: "Kneeling and prone men among cover."),
            height_m: (value: 0.6, source: "estimate", confidence: estimate),
            man_area_m2: (value: 0.15, source: "estimate", confidence: estimate, notes: "Kneeling (0.45 m2) and prone (0.15 m2) men who show themselves only part of the time, to observe and fire."),
            eye_height_m: (value: 0.7, source: "estimate", confidence: estimate)),
        dug_in: (
            width_m: (value: 0.8, source: "estimate", confidence: estimate),
            height_m: (value: 0.3, source: "estimate", confidence: estimate, notes: "Head and shoulders above the parapet."),
            man_area_m2: (value: 0.06, source: "estimate", confidence: estimate, notes: "Head and shoulders, exposed only to fire."),
            eye_height_m: (value: 0.5, source: "estimate", confidence: estimate)),
        in_building: (
            width_m: (value: 0.6, source: "plan M8B-INFANTRY §3; estimate", confidence: estimate, notes: "A window."),
            height_m: (value: 0.8, source: "estimate", confidence: estimate),
            man_area_m2: (value: 0.1, source: "estimate", confidence: estimate, notes: "Head and shoulders in a window or firing port, part of the time."),
            eye_height_m: (value: 1.5, source: "estimate", confidence: estimate, notes: "Above the floor; upper floors add a storey each.")),
    ),
    dig_in_s: (value: 1200.0, source: "estimate", confidence: estimate,
        notes: "Hasty fighting positions and use of folds in the ground after about 20 minutes halted."),
    body_armour: [
        (name: "FRAGMENT VEST (6B2/6B3 CLASS), PART ISSUE", in_service: (from: 1985),
            bullet_factor: (value: 1.0, source: "calibration notes §3", confidence: low, notes: "Fragment protection only."),
            fragment_factor: (value: 0.95, source: "estimate (calibration notes §3)", confidence: estimate,
                notes: "6B2/6B3 in Afghanistan, 6B5 from 1985, issued only in part and still partial in 2005: a third of the Blue effect.")),
    ],
    anti_armour: [
        // RPG-7 class launcher (decision 3: one of the seven men carries it instead of a rifle;
        // FM 100-2-3 (1991) lists the RPG-7 gunner inside the squad). Rounds per launcher with the
        // assistant's; the gunner fires the first round that defeats the target (cheapest first).
        (name: "RPG-7 CLASS", in_service: (from: 1961, to: 1976), class: rocket, count: 1,
            load: [(ammo: "rkt_pg7v", count: 4)],
            sight: (
            estimated_range_error_fraction: (value: 0.12, source: "US Army tests via Isby (1988) and plan M8B-AT-TEAMS §2.2", confidence: low, notes: "Trained gunners were 10-15 % off in range; through the rocket's drop this becomes a vertical miss growing with range."),
            ballistic_error_mrad: (value: 1.5, source: "estimate", confidence: estimate, notes: "Launch jitter and crosswind (decision 10: wind folded in here)."),
            aim_error_mrad: (value: 7.0, source: "fitted to Isby (1988) and the 1976 US Army evaluation (Wikipedia, RPG-7)", confidence: low, notes: "Fit on a 5 x 2.5 m panel: 0.92 / 0.55 / 0.31 / 0.11 at 100 / 200 / 300 / 500 m stationary (table 0.91 / 0.52 / 0.27 / 0.05), 0.91 / 0.51 / 0.27 / 0.09 crossing at 4 m/s (table 0.96 / 0.51 / 0.22 / 0.04)."),
            lead_error_fraction: (value: 0.3, source: "estimate", confidence: estimate)),
            setup_s: (value: 5.0, source: "estimate", confidence: estimate, notes: "Shoulder, sight and fire from a halt."),
            reload_s: (value: 12.0, source: "estimate", confidence: estimate, notes: "Load the next rocket and re-aim."),
            signature_factor: (value: 1.5, source: "estimate", confidence: estimate, notes: "Backblast flash and dust on top of the firing cue.")),
        (name: "RPG-7 CLASS", in_service: (from: 1977, to: 1987), class: rocket, count: 1,
            load: [(ammo: "rkt_pg7v", count: 1), (ammo: "rkt_pg7vl", count: 3)],
            sight: (
            estimated_range_error_fraction: (value: 0.12, source: "US Army tests via Isby (1988) and plan M8B-AT-TEAMS §2.2", confidence: low, notes: "Trained gunners were 10-15 % off in range; through the rocket's drop this becomes a vertical miss growing with range."),
            ballistic_error_mrad: (value: 1.5, source: "estimate", confidence: estimate, notes: "Launch jitter and crosswind (decision 10: wind folded in here)."),
            aim_error_mrad: (value: 7.0, source: "fitted to Isby (1988) and the 1976 US Army evaluation (Wikipedia, RPG-7)", confidence: low, notes: "Fit on a 5 x 2.5 m panel: 0.92 / 0.55 / 0.31 / 0.11 at 100 / 200 / 300 / 500 m stationary (table 0.91 / 0.52 / 0.27 / 0.05), 0.91 / 0.51 / 0.27 / 0.09 crossing at 4 m/s (table 0.96 / 0.51 / 0.22 / 0.04)."),
            lead_error_fraction: (value: 0.3, source: "estimate", confidence: estimate)),
            setup_s: (value: 5.0, source: "estimate", confidence: estimate),
            reload_s: (value: 12.0, source: "estimate", confidence: estimate),
            signature_factor: (value: 1.5, source: "estimate", confidence: estimate)),
        (name: "RPG-7 CLASS", in_service: (from: 1988), class: rocket, count: 1,
            load: [(ammo: "rkt_pg7v", count: 1), (ammo: "rkt_pg7vl", count: 2), (ammo: "rkt_pg7vr", count: 1)],
            sight: (
            estimated_range_error_fraction: (value: 0.12, source: "US Army tests via Isby (1988) and plan M8B-AT-TEAMS §2.2", confidence: low, notes: "Trained gunners were 10-15 % off in range; through the rocket's drop this becomes a vertical miss growing with range."),
            ballistic_error_mrad: (value: 1.5, source: "estimate", confidence: estimate, notes: "Launch jitter and crosswind (decision 10: wind folded in here)."),
            aim_error_mrad: (value: 7.0, source: "fitted to Isby (1988) and the 1976 US Army evaluation (Wikipedia, RPG-7)", confidence: low, notes: "Fit on a 5 x 2.5 m panel: 0.92 / 0.55 / 0.31 / 0.11 at 100 / 200 / 300 / 500 m stationary (table 0.91 / 0.52 / 0.27 / 0.05), 0.91 / 0.51 / 0.27 / 0.09 crossing at 4 m/s (table 0.96 / 0.51 / 0.22 / 0.04)."),
            lead_error_fraction: (value: 0.3, source: "estimate", confidence: estimate)),
            setup_s: (value: 5.0, source: "estimate", confidence: estimate),
            reload_s: (value: 12.0, source: "estimate", confidence: estimate),
            signature_factor: (value: 1.5, source: "estimate", confidence: estimate,
                notes: "Tandem rockets were issued only in part: one in the load.")),
        // Light disposable launchers issued as rounds of ammunition (FM 100-2-3, 1991).
        (name: "RPG-18 CLASS", in_service: (from: 1972, to: 1984), class: rocket, count: 1,
            load: [(ammo: "rkt_64", count: 1)],
            sight: (
            estimated_range_error_fraction: (value: 0.12, source: "US Army tests via Isby (1988) and plan M8B-AT-TEAMS §2.2", confidence: low, notes: "Trained gunners were 10-15 % off in range; through the rocket's drop this becomes a vertical miss growing with range."),
            ballistic_error_mrad: (value: 1.5, source: "estimate", confidence: estimate, notes: "Launch jitter and crosswind (decision 10: wind folded in here)."),
            aim_error_mrad: (value: 5.7, source: "fitted to FM 3-23.25 (2001) via Wikipedia (M72 LAW): below one hit in two beyond the effective range", confidence: low, notes: "0.5 at 200 m on a stationary 5 x 2.5 m panel with the M72 rocket."),
            lead_error_fraction: (value: 0.3, source: "estimate", confidence: estimate)),
            setup_s: (value: 10.0, source: "estimate", confidence: estimate, notes: "Extend the tube, arm, aim."),
            reload_s: (value: 5.0, source: "estimate", confidence: estimate, notes: "The next man fires his own launcher."),
            signature_factor: (value: 1.5, source: "estimate", confidence: estimate)),
        (name: "RPG-26 CLASS", in_service: (from: 1985), class: rocket, count: 1,
            load: [(ammo: "rkt_72", count: 1)],
            sight: (
            estimated_range_error_fraction: (value: 0.12, source: "US Army tests via Isby (1988) and plan M8B-AT-TEAMS §2.2", confidence: low, notes: "Trained gunners were 10-15 % off in range; through the rocket's drop this becomes a vertical miss growing with range."),
            ballistic_error_mrad: (value: 1.5, source: "estimate", confidence: estimate, notes: "Launch jitter and crosswind (decision 10: wind folded in here)."),
            aim_error_mrad: (value: 5.7, source: "fitted to FM 3-23.25 (2001) via Wikipedia (M72 LAW): below one hit in two beyond the effective range", confidence: low, notes: "0.5 at 200 m on a stationary 5 x 2.5 m panel with the M72 rocket."),
            lead_error_fraction: (value: 0.3, source: "estimate", confidence: estimate)),
            setup_s: (value: 10.0, source: "estimate", confidence: estimate, notes: "Extend the tube, arm, aim."),
            reload_s: (value: 5.0, source: "estimate", confidence: estimate, notes: "The next man fires his own launcher."),
            signature_factor: (value: 1.5, source: "estimate", confidence: estimate)),
    ],
)
