// Blue mechanised rifle squad as carried by one IFV (plan M8B-INFANTRY §1: one squad is what one
// IFV carries). Mirrors the dismount element of a Bradley (six men per M2; FM 7-7J (1986)). The
// real platoon cross-loads three nine-man squads over four vehicles; that detail does not change
// a tank decision and is cut (plan §0).
(
    id: "rifle_squad_b",
    name: "RIFLE SQUAD (MECH)",
    mirrors: "US mechanised infantry dismount team, M2-mounted (FM 7-7J, 1986)",
    in_service: (from: 1975),
    men: 6,
    weapons: [
        (name: "5.56 MM RIFLES", in_service: (from: 1960, to: 2002), count: 5,
            rounds_per_burst: (value: 3.0, source: "FM 3-22.9 (2008), rates of fire: rapid semiautomatic", confidence: low, notes: "Three aimed shots per engagement."),
            burst_interval_s: (value: 10.0, source: "FM 3-22.9 (2008): sustained 12-15 rounds/min, rapid 45", confidence: low, notes: "About 18 rounds per minute per rifle."),
            max_range_m: (value: 500.0, source: "FM 3-22.9 (2008): maximum effective range, point target 460-550 m", confidence: medium),
            dispersion_mrad: (value: 6.0, source: "Hitchman, ORO-T-160 (1952) range trials (about 2 mrad) x Rowland (JORS 1987, 1991) combat degradation of hits by 7-10x", confidence: low, notes: "Combat aiming error at fleeting, partly hidden targets. Hits per round fall with the square of the error, so 7-10x fewer hits than in trials gives 2 mrad x 2.6-3.2 = 5.3-6.3 mrad. tanks-headless firefight (2026-10-24): about 250 rounds per casualty against a halted squad at 250 m (target 100-250)."),
            bursts: 70),
        (name: "5.56 MM RIFLES (RED DOT)", in_service: (from: 2003), count: 5,
            rounds_per_burst: (value: 3.0, source: "FM 3-22.9 (2008), rates of fire: rapid semiautomatic", confidence: low, notes: "Three aimed shots per engagement."),
            burst_interval_s: (value: 10.0, source: "FM 3-22.9 (2008): sustained 12-15 rounds/min, rapid 45", confidence: low, notes: "About 18 rounds per minute per rifle."),
            max_range_m: (value: 500.0, source: "FM 3-22.9 (2008): maximum effective range, point target 460-550 m", confidence: medium),
            dispersion_mrad: (value: 5.0, source: "ARL-TR-8594 (2018), from a search excerpt: mean hit rate 0.69 with iron sights against 0.86 with the M68 at 100-400 m; a 2016 Army report via a forum: 50 % hits at 300 m with an Aimpoint; estimate", confidence: estimate, notes: "M68 close combat optic, adopted 1997, general issue to deployed units by about 2003-05 (calibration notes §3). 6 -> 5 mrad gives about 1.4x the hits per round; optics help most by finding partly hidden men. Verify against the PDF."),
            bursts: 70),
        (name: "7.62 MM MG", in_service: (from: 1960, to: 1984), count: 1,
            rounds_per_burst: (value: 8.0, source: "FM 3-22.68 (2003): bursts of 6-9 rounds", confidence: medium),
            burst_interval_s: (value: 5.0, source: "FM 3-22.68 (2003): M60 sustained rate 100 rounds/min", confidence: medium),
            max_range_m: (value: 1100.0, source: "FM 3-22.68 (2003): M60 bipod, area target", confidence: medium),
            dispersion_mrad: (value: 5.0, source: "estimate; checked against Rowland via a secondary source (MG about 8x a rifle)", confidence: estimate, notes: "Bipod beaten zone plus aiming error under fire. tanks-headless firefight (2026-10-24): one M60 causes 7.5-8.2x the casualties of one rifle at 100-400 m (target 6-10x)."),
            bursts: 90),
        (name: "5.56 MM SAW", in_service: (from: 1985), count: 1,
            rounds_per_burst: (value: 6.0, source: "FM 3-22.68 (2003): M249 bursts of 3-5 to 6-9 rounds", confidence: medium),
            burst_interval_s: (value: 6.0, source: "FM 3-22.68 (2003): M249 sustained rate 50 rounds/min", confidence: medium),
            max_range_m: (value: 800.0, source: "FM 3-22.68 (2003): M249 bipod, area target", confidence: medium),
            dispersion_mrad: (value: 6.0, source: "estimate", confidence: estimate),
            bursts: 100),
    ],
    sensors: [
        (name: "EYES", kind: optical, in_service: (from: 1900),
            cycles_per_mrad: (value: 1.7, source: "estimate: visual acuity of about 1 arcminute per detail", confidence: estimate)),
        (name: "BINOCULARS", kind: optical, in_service: (from: 1900),
            cycles_per_mrad: (value: 4.0, source: "estimate", confidence: estimate, notes: "7x glasses used by the squad leader part of the time; well below their full resolution.")),
        (name: "STARLIGHT SCOPE", kind: night_channel, in_service: (from: 1967, to: 1989),
            cycles_per_mrad: (value: 0.6, source: "estimate", confidence: estimate),
            max_range_m: (value: 400.0, source: "estimate: AN/PVS-2 class, first-generation intensifier", confidence: estimate)),
        (name: "NIGHT VISION GOGGLES", kind: night_channel, in_service: (from: 1990, to: 2001),
            cycles_per_mrad: (value: 1.0, source: "estimate", confidence: estimate),
            max_range_m: (value: 300.0, source: "estimate: AN/PVS-7 class goggles", confidence: estimate)),
        (name: "NIGHT VISION MONOCULAR", kind: night_channel, in_service: (from: 2002),
            cycles_per_mrad: (value: 1.3, source: "estimate (docs/plans/M8B-CALIBRATION-NOTES.md §3)", confidence: estimate,
                notes: "AN/PVS-14 class Gen III monocular. Issue dates around 2000-03 are unconfirmed in the sources; 2002 is a midpoint."),
            max_range_m: (value: 350.0, source: "estimate", confidence: estimate)),
    ],
    signature: (
        moving: (
            width_m: (value: 1.5, source: "plan M8B-INFANTRY §3; estimate", confidence: estimate, notes: "A group of two or three men in view at once."),
            height_m: (value: 1.8, source: "estimate", confidence: estimate),
            man_area_m2: (value: 0.5, source: "estimate", confidence: estimate, notes: "Crouched rushes rather than a 0.75 m2 standing man."),
            eye_height_m: (value: 1.6, source: "estimate", confidence: estimate)),
        halted: (
            width_m: (value: 1.0, source: "estimate", confidence: estimate, notes: "Kneeling and prone men among cover."),
            height_m: (value: 0.6, source: "estimate", confidence: estimate),
            man_area_m2: (value: 0.15, source: "estimate", confidence: estimate, notes: "Kneeling (0.45 m2) and prone (0.15 m2) men who show themselves only part of the time, to observe and fire."),
            eye_height_m: (value: 0.7, source: "estimate", confidence: estimate)),
        dug_in: (
            width_m: (value: 0.8, source: "estimate", confidence: estimate),
            height_m: (value: 0.3, source: "estimate", confidence: estimate, notes: "Head and shoulders above the parapet."),
            man_area_m2: (value: 0.06, source: "estimate", confidence: estimate, notes: "Head and shoulders, exposed only to fire."),
            eye_height_m: (value: 0.5, source: "estimate", confidence: estimate)),
        in_building: (
            width_m: (value: 0.6, source: "plan M8B-INFANTRY §3; estimate", confidence: estimate, notes: "A window."),
            height_m: (value: 0.8, source: "estimate", confidence: estimate),
            man_area_m2: (value: 0.1, source: "estimate", confidence: estimate, notes: "Head and shoulders in a window or firing port, part of the time."),
            eye_height_m: (value: 1.5, source: "estimate", confidence: estimate, notes: "Above the floor; upper floors add a storey each.")),
    ),
    dig_in_s: (value: 1200.0, source: "estimate", confidence: estimate,
        notes: "Hasty fighting positions and use of folds in the ground after about 20 minutes halted."),
    body_armour: [
        (name: "FRAGMENT VEST (PASGT CLASS)", in_service: (from: 1983, to: 2003),
            bullet_factor: (value: 1.0, source: "calibration notes §3", confidence: low, notes: "Stops fragments only, not rifle bullets."),
            fragment_factor: (value: 0.85, source: "estimate (calibration notes §3)", confidence: estimate,
                notes: "Covers the torso against fragments; the head, limbs and pelvis stay exposed.")),
        (name: "VEST WITH PLATES (INTERCEPTOR/SAPI CLASS)", in_service: (from: 2004),
            bullet_factor: (value: 0.87, source: "estimate from Owens et al. (2008) via the UTMB record: thorax wounds 6 % in OIF/OEF against 13 % in WWII and Vietnam", confidence: estimate,
                notes: "Plates stop 7.62 x 39 and 5.45 mm ball (SAPI from 1999, general issue in theatre by early 2004). Hit-out chance 0.6 -> 0.52 (fewer torso wounds). Verify against the paper."),
            fragment_factor: (value: 0.85, source: "estimate (calibration notes §3)", confidence: estimate)),
    ],
    aiming_aids: [
        (name: "IR AIMING LASER WITH GOGGLES (PEQ-2 CLASS)", in_service: (from: 2002),
            night_factor: (value: 1.1, source: "estimate (calibration notes §3)", confidence: estimate,
                notes: "An infrared laser seen through the goggles allows aimed fire at night. Issue date around 2000-03, unconfirmed. Earlier IR aiming lights (AN/PAQ-4 class) are not listed: their issue dates are not in the sources yet.")),
    ],
)
