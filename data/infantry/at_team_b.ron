// Blue anti-tank missile team (plan M8B-AT-TEAMS §2.1): a dismounted team of three with a
// medium anti-tank missile, Dragon class until the Javelin class arrives. Mirrors the Dragon and
// Javelin teams of a US mechanised infantry platoon (FM 23-24, 1987; FM 3-22.37, 2008).
(
    id: "at_team_b",
    name: "AT TEAM (ATGM)",
    mirrors: "US Dragon / Javelin team (FM 23-24, 1987; FM 3-22.37, 2008)",
    in_service: (from: 1975),
    men: 3,
    weapons: [
        (name: "5.56 MM RIFLES", count: 3,
            rounds_per_burst: (value: 3.0, source: "as for the rifle squad", confidence: low),
            burst_interval_s: (value: 10.0, source: "as for the rifle squad", confidence: low),
            max_range_m: (value: 500.0, source: "FM 3-22.9 (2008)", confidence: medium),
            dispersion_mrad: (value: 6.0, source: "as for the rifle squad", confidence: low),
            bursts: 50),
    ],
    sensors: [
        (name: "EYES", kind: optical, in_service: (from: 1900),
            cycles_per_mrad: (value: 1.7, source: "estimate: visual acuity of about 1 arcminute per detail", confidence: estimate)),
        (name: "BINOCULARS", kind: optical, in_service: (from: 1900),
            cycles_per_mrad: (value: 4.0, source: "estimate", confidence: estimate)),
        (name: "DRAGON NIGHT TRACKER (THERMAL)", kind: thermal, in_service: (from: 1981, to: 1995),
            cycles_per_mrad: (value: 1.5, source: "estimate", confidence: estimate,
                notes: "AN/TAS-5 class first-generation thermal tracker; fielding date and performance are estimates."),
            max_range_m: (value: 1200.0, source: "estimate", confidence: estimate)),
        (name: "COMMAND LAUNCH UNIT (THERMAL)", kind: thermal, in_service: (from: 1996),
            cycles_per_mrad: (value: 3.0, source: "estimate", confidence: estimate,
                notes: "Javelin launch unit: 4x day sight and a 4x / 9x staring-array thermal sight (FM 3-22.37). Used as a stand-alone observation sight."),
            max_range_m: (value: 3000.0, source: "estimate", confidence: estimate)),
    ],
    signature: (
        moving: (
            width_m: (value: 1.2, source: "estimate (plan M8B-AT-TEAMS §4: a smaller group than a squad)", confidence: estimate, notes: "Three men carrying the launcher and rounds."),
            height_m: (value: 1.8, source: "estimate", confidence: estimate),
            man_area_m2: (value: 0.5, source: "estimate as for a squad", confidence: estimate),
            eye_height_m: (value: 1.6, source: "estimate", confidence: estimate)),
        halted: (
            width_m: (value: 0.8, source: "estimate", confidence: estimate),
            height_m: (value: 0.6, source: "estimate", confidence: estimate),
            man_area_m2: (value: 0.15, source: "estimate as for a squad", confidence: estimate),
            eye_height_m: (value: 0.7, source: "estimate", confidence: estimate)),
        dug_in: (
            width_m: (value: 0.6, source: "estimate", confidence: estimate),
            height_m: (value: 0.3, source: "estimate", confidence: estimate),
            man_area_m2: (value: 0.06, source: "estimate as for a squad", confidence: estimate),
            eye_height_m: (value: 0.5, source: "estimate", confidence: estimate)),
        in_building: (
            width_m: (value: 0.6, source: "estimate as for a squad: a window", confidence: estimate),
            height_m: (value: 0.8, source: "estimate", confidence: estimate),
            man_area_m2: (value: 0.1, source: "estimate as for a squad", confidence: estimate),
            eye_height_m: (value: 1.5, source: "estimate", confidence: estimate)),
    ),
    dig_in_s: (value: 1200.0, source: "estimate as for a squad", confidence: estimate),
    anti_armour: [
        (name: "DRAGON CLASS", in_service: (from: 1975, to: 1987), class: missile, count: 1,
            load: [(ammo: "atgm_dragon", count: 3)],
            sight: (
                estimated_range_error_fraction: (value: 0.12, source: "US tests via plan M8B-AT-TEAMS §2.2", confidence: low, notes: "Unused for a guided round (no drop)."),
                ballistic_error_mrad: (value: 0.0, source: "guided: no ballistic error", confidence: high),
                aim_error_mrad: (value: 0.5, source: "estimate", confidence: estimate, notes: "Tracker held on the target for the whole flight, shoulder-fired from a bipod: notoriously hard to keep steady."),
                lead_error_fraction: (value: 0.0, source: "guided: no lead", confidence: high)),
            setup_s: (value: 20.0, source: "estimate", confidence: estimate, notes: "Mount the tracker on the round, emplace the bipod."),
            reload_s: (value: 30.0, source: "estimate", confidence: estimate, notes: "A new round for each shot."),
            signature_factor: (value: 2.0, source: "estimate", confidence: estimate, notes: "Launch flash and smoke, and a missile in flight that observers follow back to the post.")),
        (name: "DRAGON CLASS", in_service: (from: 1988, to: 1995), class: missile, count: 1,
            load: [(ammo: "atgm_dragon2", count: 3)],
            sight: (
                estimated_range_error_fraction: (value: 0.12, source: "US tests via plan M8B-AT-TEAMS §2.2", confidence: low, notes: "Unused for a guided round (no drop)."),
                ballistic_error_mrad: (value: 0.0, source: "guided: no ballistic error", confidence: high),
                aim_error_mrad: (value: 0.5, source: "estimate", confidence: estimate, notes: "As the first version."),
                lead_error_fraction: (value: 0.0, source: "guided: no lead", confidence: high)),
            setup_s: (value: 20.0, source: "estimate", confidence: estimate, notes: "As the first version."),
            reload_s: (value: 30.0, source: "estimate", confidence: estimate, notes: "A new round for each shot."),
            signature_factor: (value: 2.0, source: "estimate", confidence: estimate, notes: "Launch flash and smoke, and a missile in flight that observers follow back to the post.")),
        (name: "JAVELIN CLASS", in_service: (from: 1996), class: missile, count: 1,
            load: [(ammo: "atgm_javelin", count: 3)],
            sight: (
                estimated_range_error_fraction: (value: 0.12, source: "US tests via plan M8B-AT-TEAMS §2.2", confidence: low, notes: "Unused for a guided round (no drop)."),
                ballistic_error_mrad: (value: 0.0, source: "guided: no ballistic error", confidence: high),
                aim_error_mrad: (value: 0.2, source: "estimate", confidence: estimate, notes: "Lock-on before launch; the seeker does the rest."),
                lead_error_fraction: (value: 0.0, source: "guided: no lead", confidence: high)),
            setup_s: (value: 30.0, source: "estimate", confidence: estimate, notes: "Seeker cool-down before the first lock."),
            reload_s: (value: 20.0, source: "estimate", confidence: estimate, notes: "Attach a new round, lock on."),
            signature_factor: (value: 2.0, source: "estimate", confidence: estimate, notes: "Launch flash and smoke, and a missile in flight that observers follow back to the post.")),
    ],
)
